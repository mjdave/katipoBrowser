{
    if(textEntryView.promptTextView)
    {
        textEntryView.removeView(textEntryView.promptTextView)
    }

    if(promptText and promptText != "")
    {
        /*promptTextView = TextView.new(textEntryView) #todo
        promptTextView.font = Font(textEntryView.fontName, textEntryView.fontSize)
        promptTextView.relativePosition = ViewPosition(textEntryView.horizontalAlignment, textEntryView.verticalAlignment)
        promptTextView.pos = textEntryView.initialOffset

        promptTextView:addColoredText(promptText, promptColor)
    
        textEntryView.promptTextView = promptTextView

        textEntryView.textView.pos = textEntryView.initialOffset + vec3(promptTextView.size.x,0,0) #todo this only supports left alignment
        */
    }
}