keys = require("app/common/keys.tui")

setText = false

getViewLayout = function(viewLayout)
{
    buttonViewLayout = {}
    for(k,v in viewLayout)
    {
        buttonViewLayout[k] = v
    }

    buttonViewLayout.type = "view"
    
    return buttonViewLayout
}

create = function(parentView, viewLayout)
{
    textEntryView = parentView.addView(getViewLayout(viewLayout))

    markupViewLayout = {
        type = "markup"
        #font = viewLayout.font
        variableHeight = true
        variableWidth = true
        #fontSize = viewLayout.fontSize
        alignmentX = viewLayout.alignmentX
        verticalAlignment = viewLayout.verticalAlignment
        #pos = vec3(xOffset,yOffset,0)
    }

    textEntryView.minWidth = viewLayout.minWidth
    if(!textEntryView.minWidth)
    {
        textEntryView.minWidth = 20
    }

    entryMarkupView = textEntryView.addView(markupViewLayout)
    textEntryView.textEntryMarkupView = entryMarkupView
    textEntryView.setText = function(text)
    {
        setText(textEntryView, text)
    }

    textEntryView.revertToEditStartText = function()
    {
        if(textEntryView.editStartTextValue)
        {
            setText(textEntryView, textEntryView.editStartTextValue)
        }
    }

    textEntryView.setOnStartedEditing = function(func)
    {
        textEntryView.textEntryMarkupView.onStartedEditing = func
    }

    textEntryView.setOnFinishedEditing = function(func)
    {
        textEntryView.onFinishedEditing = func
    }

    textEntryView.setOnTextChanged = function(func)
    {
        textEntryView.onTextChanged = func
    }

    textEntryView.textEntryClickFunction = function()
    {
        textEntryView.textEntryMarkupView.callBackgroundClickFunction("textEntryStyle")
    }

    entryMarkupView.styles = {
        textEntryStyle = {
            font = viewLayout.font
            fontSize = viewLayout.fontSize
            backgroundColor = viewLayout.backgroundColor
            maxChars = viewLayout.maxChars
            textEntry = function(text, confirmChanges)
            {
                if(textEntryView.onFinishedEditing)
                {
                    textEntryView.onFinishedEditing(text, confirmChanges)
                }
            }
            onTextChanged = function(text)
            {
                if(textEntryView.onTextChanged)
                {
                    textEntryView.onTextChanged(text)
                }
            }
        }
    }

    return textEntryView
}

setAllowsEmpty = function(textEntryView, allowsEmpty) #todo pass this on to markup view
{ #defaults to not allowing empty strings
    #textEntryView.allowsEmpty = allowsEmpty
}

setText = function(textEntryView, text_)
{
    textToUse = text_
    if(!textToUse)
    {
        textToUse = ""
    }
    elseif(type(textToUse) != "string")
    {
        error("in textEntry.setText(). expected string, got ", type(textToUse), ": ", textToUse)
    }

    if(textEntryView.maxChars and textToUse and string.length(textToUse) > textEntryView.maxChars)
    {
        textToUse = string.subString(textToUse, 0, textEntryView.maxChars)
    }

    textEntryView.text = textToUse
    
    textEntryView.textEntryMarkupView.setTextWithStyleID(textToUse, "textEntryStyle")
}

getText = function(textEntryView)
{
    return textEntryView.text
}