
headerHeight = 40
rowHeight = 40
headerBackButtonSize = vec2(30,30)

leftPaneLayout = {
    type = "view"
    alignmentX = "left"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x / 2, parentSize.y)
    }
    subviews = {
        {
            id = "headerLeft"
            type = "color"
            color = vec4(0.2,0.3,0.0,0.2)
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x, headerHeight)
            }
            alignmentY = "top"
            subviews = {
                {
                    id = "headerBackButton"
                    hidden = true
                    type = "button"
                    buttonType = "imageHueShift"
                    path = "images/back.png"
                    size = headerBackButtonSize
                    pos = vec3(10,0,0)
                    alignmentX = "left"
                }
                {
                    id = "headerTitleLeft"
                    type = "text"
                    text = "Directory"
                    font = "roboto"
                    additiveBlend = true
                    fontSize = 14
                }
            }
        }
        {
            type = "scrollView"
            id = "scrollView"
            alignmentY = "bottom"
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x, parentSize.y - headerHeight)
            }
        }
    }
}

rightPaneLayout = {
    type = "view"
    alignmentX = "right"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x / 2, parentSize.y)
    }

    subviews = {
        {
            id = "headerRight"
            type = "color"
            color = vec4(0.0,0.2,0.3,0.2)
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x, headerHeight)
            }
            alignmentY = "top"
            subviews = {
                {
                    id = "headerTitleRight"
                    type = "text"
                    text = "File"
                    font = "roboto"
                    additiveBlend = true
                    fontSize = 14
                }
            }
        }
        {
            type = "scrollView"
            id = "scrollView"
            alignmentY = "bottom"
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x, parentSize.y - headerHeight)
            }
        }
    }
}

leftPanelVerticalLayout = {
    type = "view"
    alignmentY = "top"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, parentSize.y / 2)
    }
    subviews = leftPaneLayout.subviews
}

rightPanelVerticalLayout = {
    type = "view"
    alignmentY = "bottom"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, parentSize.y / 2)
    }
    subviews = rightPaneLayout.subviews
}

fileItemLayout = {
    id = "fileItem"
    type = "view"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x - 20.0,rowHeight)
    }

    subviews = {
        {
            id = "fileItemBackground"
            type = "button"
            buttonType = "color"
            additiveBlend = true
            color = vec4(0.0,0.05,0.1,0.3)
        }
        {
            id = "fileItemTitle"
            type = "text"
            text = "Title"
            font = "roboto"
            alignmentX = "left"
            additiveBlend = true
            pos = vec3(10,0,0)
            fontSize = 14
        }
    }
}

dirItemLayout = {
    id = "dirItem"
    type = "view"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x - 20.0,rowHeight)
    }

    subviews = {
        {
            id = "fileItemBackground"
            type = "button"
            buttonType = "color"
            additiveBlend = true
            color = vec4(0.0,0.05,0.1,0.3)
        }
        {
            id = "fileItemTitle"
            type = "text"
            text = "Title"
            font = "roboto"
            fontSize = 14
            alignmentX = "left"
            additiveBlend = true
            pos = vec3(10,0,0)
        }
        {
            id = "dirMarker"
            type = "text"
            font = "roboto"
            fontSize = 18
            text = ">"
            pos = vec3(-10,0, 0)
            alignmentX = "right"
        }
    }
}


compareFunction = function(a,b)
{
    return a.fileName < b.fileName
}

setDirectoryTree = function(fileBrowserView, directoryTree, selectedIndex, isFromNavigation) #todo we could also create directoryTree if given a path argument. directoryTreeOrPath, and add a createDirectoryTree function
{
    fileBrowserView.currentFile = directoryTree
    fileBrowserView.leftSelectedIndex = selectedIndex

    if(onBrowserContentChange)
    {
        onBrowserContentChange()
    }

    if(fileBrowserView.leftPaneView)
    {
        fileBrowserView.removeView(fileBrowserView.leftPaneView)
    }

    leftLayoutToUse = leftPaneLayout
    if(fileBrowserView.parentSize.y > fileBrowserView.parentSize.x)
    {
        print("using vertical layout")
        leftLayoutToUse = leftPanelVerticalLayout
    }

    leftPaneView = fileBrowserView.addView(leftLayoutToUse)
    fileBrowserView.leftPaneView = leftPaneView

    if(!isFromNavigation)
    {
        fileBrowserView.currentDirectoryStack = {
            {
                tree = directoryTree
                selectedIndex = selectedIndex
            }
        }
    }
    
    headerBackButton = leftPaneView.getView("headerBackButton")
    stackCount = table.count(fileBrowserView.currentDirectoryStack)
    if(stackCount > 1)
    {
        headerBackButton.hidden = false
        headerBackButtonClickFunction = function()
        {
            if(fileBrowserView.currentDirectoryStack)
            {
                stackCount = table.count(fileBrowserView.currentDirectoryStack)
                if(stackCount > 1)
                {
                    prevStackInfo = fileBrowserView.currentDirectoryStack[stackCount - 1]
                    newStackInfo = fileBrowserView.currentDirectoryStack[stackCount - 2]
                    table.remove(fileBrowserView.currentDirectoryStack, stackCount - 1)
                    setDirectoryTree(fileBrowserView, newStackInfo.tree, prevStackInfo.selectedIndex, true)
                }
            }
        }
        headerBackButton.click = headerBackButtonClickFunction
        headerBackButton.hueOffset = -0.1
    }
    else
    {
        headerBackButton.hidden = true
    }

    fileBrowserView.headerTitleLeft = leftPaneView.getView("headerTitleLeft")
    fileBrowserView.headerTitleLeft.text = directoryTree.fileName

    leftPaneScrollView = leftPaneView.getView("scrollView")

    #print("directoryTree:", directoryTree)

    updateRightPanel = function(subTree)
    {
        if(fileBrowserView.rightPaneView)
        {
            fileBrowserView.removeView(fileBrowserView.rightPaneView)
            fileBrowserView.rightPaneView = nil
        }

        fileBrowserView.rightItemViews = {}

        rightLayoutToUse = rightPaneLayout
        if(fileBrowserView.parentSize.y > fileBrowserView.parentSize.x)
        {
            rightLayoutToUse = rightPanelVerticalLayout
        }

        rightPaneView = fileBrowserView.addView(rightLayoutToUse)
        fileBrowserView.rightPaneView = rightPaneView

        fileBrowserView.headerTitleRight = rightPaneView.getView("headerTitleRight")
        if(!subTree)
        {
            fileBrowserView.headerTitleRight.text = ""
        }
        else
        {
            fileBrowserView.headerTitleRight.text = subTree.fileName

            if(subTree.files)
            {
                sortedFiles = {}
                for(i,file in subTree.files)
                {
                    table.insert(sortedFiles, file)
                }
                table.sort(sortedFiles, compareFunction)

                rightPaneScrollView = rightPaneView.getView("scrollView")

                for(i,file in sortedFiles)
                {
                    itemLayout = dirItemLayout
                    if(file.localPath)
                    {
                        itemLayout = fileItemLayout
                    }
                    itemView = rightPaneScrollView.addView(itemLayout)
                    itemView.fileInfo = file

                    titleTextView = itemView.getView("fileItemTitle")
                    titleTextView.text = file.fileName

                    backgroundView = itemView.getView("fileItemBackground")
                    if(i % 2 == 0)
                    {
                        backgroundView.color.w = 0.5
                    }
                    backgroundView.baseColor = backgroundView.color

                    backgroundView.click = function() #right panel click
                    {
                        if(file.files)
                        {
                            tuiBug = { #definite tui bug here, couldn't pass this directly as function arg
                                selectedIndex = fileBrowserView.leftSelectedIndex
                                tree = subTree
                            }
                            
                            table.insert(fileBrowserView.currentDirectoryStack, tuiBug)
                            setDirectoryTree(fileBrowserView, subTree, i, true)
                        }
                    }

                    table.insert(fileBrowserView.rightItemViews, itemView)

                    if(onBrowserItemCreate)
                    {
                        onBrowserItemCreate(itemView, i)
                    }
                }
            }
        }
    }

    if(directoryTree.files)
    {
        fileBrowserView.leftItemViews = {}

        sortedFiles = {}
        for(i,file in directoryTree.files)
        {
            table.insert(sortedFiles, file)
        }
        table.sort(sortedFiles, compareFunction)

        for(i,file in sortedFiles)
        {
            itemLayout = dirItemLayout
            if(file.localPath)
            {
                itemLayout = fileItemLayout
            }
            itemView = leftPaneScrollView.addView(itemLayout)
            itemView.fileInfo = file
            titleTextView = itemView.getView("fileItemTitle")
            titleTextView.text = file.fileName

            backgroundView = itemView.getView("fileItemBackground")
            if(i % 2 == 0)
            {
                backgroundView.color.w = 0.5
            }
            backgroundView.baseColor = backgroundView.color

            if(!file.localPath)
            {
                backgroundView.click = function() #left panel click
                {
                    if(fileBrowserView.leftSelectedIndex)
                    {
                        if(table.count(fileBrowserView.leftItemViews) > fileBrowserView.leftSelectedIndex)
                        {
                            previousItemView = fileBrowserView.leftItemViews[fileBrowserView.leftSelectedIndex]
                            previousBackgroundView = previousItemView.getView("fileItemBackground")
                            previousBackgroundView.setSelected(false)
                        }
                    }
                    backgroundView.setSelected(true)
                    fileBrowserView.leftSelectedIndex = i
                    updateRightPanel(file)

                    if(onBrowserContentChange)
                    {
                        onBrowserContentChange()
                    }
                }

                if(fileBrowserView.leftSelectedIndex == i)
                {
                    backgroundView.setSelected(true)
                }
            }

            #leftPaneScrollView.insertRow(itemView)
            table.insert(fileBrowserView.leftItemViews, itemView)

            if(onBrowserItemCreate)
            {
                onBrowserItemCreate(itemView, i)
            }
        }

        if(fileBrowserView.leftSelectedIndex != nil)
        {
            updateRightPanel(sortedFiles[fileBrowserView.leftSelectedIndex])
        }
        else
        {
            updateRightPanel()
        }
    }

}

getViewLayout = function(viewLayout)
{
    fileBrowserViewLayout = {}
    for(k,v in viewLayout)
    {
        fileBrowserViewLayout[k] = v
    }

    fileBrowserViewLayout.type = "view"
    
    return fileBrowserViewLayout
}

create = function(parentView, viewLayout)
{
    fileBrowserView = parentView.addView(getViewLayout(viewLayout))

    fileBrowserView.onParentSizeChanged = function(parentSize)
    {
        fileBrowserView.parentSize = parentSize
        return parentSize
    }

    return fileBrowserView
}