dirItemLayout = {
    id = "fileItemBackground"
    type = "color"
    color = vec4(0.04,0.12,0.15,0.1)
    size = function(parentSize)
    {
        return vec2(parentSize.x - 20.0,rowHeight)
    }

    subviews = {
        {
            id = "fileItemTitle"
            type = "text"
            text = "Title"
            font = "blockheadsHue"
