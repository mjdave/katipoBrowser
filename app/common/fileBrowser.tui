updateItemColor = function(userData, itemView, selected, hover)
{
    if(selected)
    {
        itemView.color = itemView.baseColor + vec4(0.0,0.4,0.1,0.2)
    }
    else if(itemView.highlight)
    {
        itemView.color = itemView.baseColor + vec4(0.0,0.1,0.4,0.3)
        if(hover)
        {
            itemView.color = itemView.color + vec4(0.0,0.1,0.4,0.1)
        }
    }
    else if(hover)
    {
        itemView.color = itemView.baseColor + vec4(0.2,0.0,0.2,0.2)
    }
    else
    {
        itemView.color = itemView.baseColor
    }
}

updateVisuals = function(userData)
{
    if(userData.leftItemViews)
    {
        for(i, itemView in userData.leftItemViews)
        {
            updateItemColor(userData, itemView, i == userData.leftSelectedIndex, i == userData.leftHoverIndex)
        }
    }

    if(userData.rightItemViews)
    {
        for(i, itemView in userData.rightItemViews)
        {
            updateItemColor(userData, itemView, i == userData.rightSelectedIndex, i == userData.rightHoverIndex)
        }
    }
}

setDirectoryTree = function(fileBrowserView, directoryTree, selectedIndex, isFromNavigation) #todo we could also create directoryTree if given a path argument. directoryTreeOrPath, and add a createDirectoryTree function
{
    userData = fileBrowserView.fileBrowserViewData
    userData.currentFile = directoryTree
    userData.leftSelectedIndex = selectedIndex

    if(onBrowserContentChange)
    {
        onBrowserContentChange()
    }

    if(userData.leftPaneView)
    {
        fileBrowserView.removeView(userData.leftPaneView)
    }

    leftPaneView = fileBrowserView.addView(leftPaneLayout)
    userData.leftPaneView = leftPaneView

    if(!isFromNavigation)
    {
        userData.currentDirectoryStack = {
            {
                tree = directoryTree
                selectedIndex = selectedIndex
            }
        }
    }
    
    userData.headerBackButton = leftPaneView.getView("headerBackButton")
    stackCount = table.count(userData.currentDirectoryStack)
    if(stackCount > 1)
    {
        userData.headerBackButton.hidden = false
        headerBackButtonClickFunction = function()
        {
            if(userData.currentDirectoryStack)
            {
                stackCount = table.count(userData.currentDirectoryStack)
                if(stackCount > 1)
                {
                    prevStackInfo = userData.currentDirectoryStack[stackCount - 1]
                    newStackInfo = userData.currentDirectoryStack[stackCount - 2]
                    table.remove(userData.currentDirectoryStack, stackCount - 1)
                    setDirectoryTree(fileBrowserView, newStackInfo.tree, prevStackInfo.selectedIndex, true)
                }
            }
        }
        button.create(userData.headerBackButton, -0.1, headerBackButtonClickFunction)
    }
    else
    {
        userData.headerBackButton.hidden = true
    }

    userData.headerTitleLeft = leftPaneView.getView("headerTitleLeft")
    userData.headerTitleLeft.text = directoryTree.fileName

    leftScrollViewContent = leftPaneView.getView("scrollViewContent")
    leftPaneScrollView = scrollView.create(leftScrollViewContent)

    #print("directoryTree:", directoryTree)

    updateRightPanel = function(subTree)
    {
        if(userData.rightPaneView)
        {
            fileBrowserView.removeView(userData.rightPaneView)
            userData.rightPaneView = nil
        }

        userData.rightItemViews = {}

        rightPaneView = fileBrowserView.addView(rightPaneLayout)
        userData.rightPaneView = rightPaneView

        userData.headerTitleRight = rightPaneView.getView("headerTitleRight")
        if(!subTree)
        {
            userData.headerTitleRight.text = ""
        }
        else
        {
            userData.headerTitleRight.text = subTree.fileName

            if(subTree.files)
            {
                compareFunction = function(a,b)
                {
                    return a.fileName < b.fileName
                }
                sortedFiles = {}
                for(i,file in subTree.files)
                {
                    table.insert(sortedFiles, file)
                }
                table.sort(sortedFiles, compareFunction)

                rightScrollViewContent = rightPaneView.getView("scrollViewContent")
                rightPaneScrollView = scrollView.create(rightScrollViewContent)

                for(i,file in sortedFiles)
                {
                    itemLayout = dirItemLayout
                    if(file.localPath)
                    {
                        itemLayout = fileItemLayout
                    }
                    itemView = rightPaneScrollView.addView(itemLayout)
                    itemView.fileInfo = file

                    titleTextView = itemView.getView("fileItemTitle")
                    titleTextView.text = file.fileName

                    if(i % 2 == 0)
                    {
                        itemView.color.w = 0.5
                    }
                    
                    itemView.baseColor = itemView.color

                    itemView.hoverStart = function()
                    {
                        userData.rightHoverIndex = i
                        updateVisuals(userData)
                    }

                    itemView.hoverEnd = function()
                    {
                        if(userData.rightHoverIndex == i)
                        {
                            userData.rightHoverIndex = nil
                            updateVisuals(userData)
                        }
                    }

                    itemView.click = function() #right panel click
                    {
                        if(file.files)
                        {
                            tuiBug = { #definite tui bug here, couldn't pass this directly as function arg
                                selectedIndex = userData.leftSelectedIndex
                                tree = subTree
                            }
                            
                            table.insert(userData.currentDirectoryStack, tuiBug)
                            setDirectoryTree(fileBrowserView, subTree, i, true)
                        }
                    }

                    scrollView.insertRow(rightPaneScrollView, itemView)
                    table.insert(userData.rightItemViews, itemView)

                    if(onBrowserItemCreate)
                    {
                        onBrowserItemCreate(itemView, i)
                    }
                }
            }
        }
    }

    if(directoryTree.files)
    {
        userData.leftItemViews = {}
        compareFunction = function(a,b)
        {
            return a.fileName < b.fileName
        }

        sortedFiles = {}
        for(i,file in directoryTree.files)
        {
            table.insert(sortedFiles, file)
        }
        table.sort(sortedFiles, compareFunction)

        for(i,file in sortedFiles)
        {
            itemLayout = dirItemLayout
            if(file.localPath)
            {
                itemLayout = fileItemLayout
            }
            itemView = leftPaneScrollView.addView(itemLayout)
            itemView.fileInfo = file
            titleTextView = itemView.getView("fileItemTitle")
            titleTextView.text = file.fileName


            if(i % 2 == 0)
            {
                itemView.color.w = 0.5
            }
            
            itemView.baseColor = itemView.color

            itemView.hoverStart = function()
            {
                userData.leftHoverIndex = i
                updateVisuals(userData)
            }

            itemView.hoverEnd = function()
            {
                if(userData.leftHoverIndex == i)
                {
                    userData.leftHoverIndex = nil
                    updateVisuals(userData)
                }
            }

            if(!file.localPath)
            {
                itemView.click = function()
                {
                    userData.leftSelectedIndex = i
                    updateRightPanel(file)
                    updateVisuals(userData)

                    if(onBrowserContentChange)
                    {
                        onBrowserContentChange()
                    }
                }
            }

            scrollView.insertRow(leftPaneScrollView, itemView)
            table.insert(userData.leftItemViews, itemView)

            if(onBrowserItemCreate)
            {
                onBrowserItemCreate(itemView, i)
            }
        }

        if(userData.leftSelectedIndex != nil)
        {
            updateRightPanel(sortedFiles[userData.leftSelectedIndex])
        }
        else
        {
            updateRightPanel()
        }
    }


    updateVisuals(userData)

}


create = function(parentView)
{
    userData = {
    }

    fileBrowserViewLayout = {
        type = "view"
    }

    fileBrowserView = parentView.addView(fileBrowserViewLayout)
    userData.view = fileBrowserView
    fileBrowserView.fileBrowserViewData = userData

    return fileBrowserView
}