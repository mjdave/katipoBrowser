
scrollView = require("app/common/scrollView.tui")
button = require("app/common/button.tui")

headerHeight = 40
rowHeight = 40
headerBackButtonSize = vec2(30,30)

leftPaneLayout = {
    type = "view"
    alignmentX = "left"
    size = function(parentSize)
    {
        return vec2(parentSize.x / 2, parentSize.y)
    }
    subviews = {
        {
            id = "headerLeft"
            type = "color"
            color = vec4(0.2,0.3,0.0,0.2)
            size = function(parentSize)
            {
                return vec2(parentSize.x, headerHeight)
            }
            alignmentY = "top"
            subviews = {
                {
                    id = "headerBackButton"
                    hidden = true
                    type = "image"
                    path = "img/back.png"
                    shader = "drawQuadTexturedHueShift"
                    size = headerBackButtonSize
                    pos = vec3(10,0,0)
                    alignmentX = "left"
                }
                {
                    id = "headerTitleLeft"
                    type = "text"
                    text = "Directory"
                    font = "blockheadsHue" #todo
                    additiveBlend = true
                    fontSize = 14 #todo
                }
            }
        }
        {
            type = "view"
            id = "scrollViewContent"
            alignmentY = "bottom"
            size = function(parentSize)
            {
                return vec2(parentSize.x, parentSize.y - headerHeight)
            }
        }
    }
}

