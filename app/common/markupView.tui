keys = require("app/common/keys.tui")

topPaddingDefault = 20
leftPaddingDefault = 20 #we don't support bottom or right padding yet
minLineHeight = 20


font = "roboto"
boldFont = "robotoBold"
italicFont = "robotoItalic"
monoFont = "robotoMono"
fontSize = 16
headerFontSize = 26

linkColor = vec4(0.5,0.8,1.0,1.0)
onLinkClick = false

textLayout = {
    type = "text"
    font = "roboto"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

boldTextLayout = {
    type = "text"
    font = "robotoBold"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

monoTextLayout = {
    type = "text"
    font = "robotoMono"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

italicTextLayout = {
    type = "text"
    font = "robotoItalic"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

headerTextLayout = {
    type = "text"
    font = "robotoBold"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 26
}

getViewLayout = function(incomingLayout)
{
    #print("incomingLayout:", incomingLayout)
    layout = {}
    for(k,v in incomingLayout)
    {
        layout[k] = v
    }

    layout.type = "view"
    
    return layout
}


finishEditing = function(markupView, textView, confirmChanges)
{
    if(textView.editing and textView == markupView.currentlyEditingTextView)
    {
        print("finish editing:", textView.text)
        textView.editing = false
        markupView.currentlyEditingTextView = nil

        markupView.update = nil
        markupView.cursorView.hidden = true
        
        eventManager.removeTextEntryListener(markupView.textEntryListenerID)
        markupView.textEntryListenerID = nil

        if((!textView.text) or string.length(textView.text) == 0)
        {
            if(markupView.allowsEmpty)
            {
                if(markupView.onFinishedEditing)
                {
                    markupView.onFinishedEditing("", confirmChanges)
                }
            }
            else
            {
                updateText(markupView, textView, markupView.editStartTextValue)
                if(markupView.onFinishedEditing)
                {
                    markupView.onFinishedEditing(markupView.editStartTextValue, false)
                }
            }
        }
        else
        {
            if(!confirmChanges and markupView.requireEnterToConfirm) #requireEnterToConfirm means we should revert if !confirmChanges
            {
                updateText(markupView, textView, markupView.editStartTextValue)
                if(markupView.onFinishedEditing)
                {
                    markupView.onFinishedEditing(textView.text, false)
                }
            }
            else
            {
                if(markupView.onFinishedEditing)
                {
                    markupView.onFinishedEditing(textView.text, confirmChanges)
                }
            }
        }
    }
}

updateCursorFunction = function(markupView, dt)
{
    markupView.cursorTimer = markupView.cursorTimer + dt
    if(markupView.cursorTimer > 0.5)
    {
        markupView.cursorTimer = markupView.cursorTimer - 0.5
        if(markupView.cursorTimer > 0.5)
        {
            markupView.cursorTimer = 0.0
        }
        markupView.cursorView.hidden = (!markupView.cursorView.hidden)
    }
}

updateCursorPosition = function(markupView, textView)
{
    print("textView:", textView)
    rect = textView.getRectForCharAtIndex(-1 + textView.cursorOffset)
    print("rect:", rect, " textView.cursorOffset:", textView.cursorOffset)
    xOffset = rect.x + rect.z
    if(!textView.horizontalAlignment or textView.horizontalAlignment == "center")
    {
        xOffset /= 2
    }
    #todo handle right alignment
    print("set cursor pos:", xOffset + 1,",",rect.y + 1,0)
    markupView.cursorView.pos = vec3(xOffset + 1,rect.y + 1,0)
}

updateText = function(markupView, textEntryView, newText)
{
    setText(textEntryView, newText) #todo

    if(textEntryView.editing)
    {
        textEntryView.cursorView.hidden = false
        markupView.cursorTimer = 0.0

        updateCursorPosition(markupView, textEntryView) #todo
    }
    
    if(textEntryView.textEntryChangedContinuousFunction)
    {
        textEntryView.textEntryChangedContinuousFunction(textEntryView.text)
    }
}

textBackgroundViewClickFunction = function(markupView, textView, mouseLoc)
{
    if(!markupView.editable)
    {
        return
    }
    if(!markupView.disabled)
    {
        if(markupView.editing)
        {
            print("todo, allow cursor position change with click")
            /*if(textView.text)
            {
                textViewLoc = textView:locationRelativeToView(mouseLoc, textView.textView)

                charIndex = textView.textView:getCharIndexForPos(textViewLoc)
                textLength = string.length(textView.text)
                if(textLength > 0)
                {
                    charIndex = mjm.clamp(charIndex, 0, textLength)
                    textView.cursorOffset = charIndex - textLength
                    markupView.cursorView.hidden = false
                    markupView.cursorTimer = 0.0
                    updateCursorPosition(markupView, textView)
                    textView.textView.resetVerticalCursorMovementAnchors()
                }
            }*/
            #mj:log("mouseLoc:", mouseLoc - vec2(textView.pos.x, textView.pos.y), " charIndex:", charIndex)
        }
        else
        {
            if(markupView.currentlyEditingTextView)
            {
                markupView.currentlyEditingTextView.editing = false
            }
            markupView.currentlyEditingTextView = textView
            textView.editing = true

            #textView.textView:resetVerticalCursorMovementAnchors()
            markupView.editStartTextValue = textView.text
            markupView.cursorView.hidden = false
            markupView.cursorView.layoutParent = textView
            markupView.cursorTimer = 0.0

            textView.cursorOffset = 0

            print("start editing:", textView.text)
            markupView.update = function(dt)
            {
                updateCursorFunction(markupView, dt)
            }

            updateCursorPosition(markupView, textView)
            
            keyMap = {
                [keys.keyCodes.key_return] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown)
                    {
                        if(modCode == keys.modifiers.shift)
                        {
                            newText = textView.text + "\n"
                            updateText(textView, newText)
                        }
                        else if(!isRepeat)
                        {
                            finishEditing(markupView, textView, true)
                        }
                    }
                }
                [keys.keyCodes.backspace] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown)
                    {
                        if(textView.text and string.length(textView.text) > 0)
                        {
                            newText = ""
                            if(textView.cursorOffset and textView.cursorOffset != 0)
                            {
                                textLength = string.length(textView.text)
                                if(textLength > 0)
                                {
                                    removePos = math.max(textLength + textView.cursorOffset, 0)
                                    if(removePos >= 0)
                                    {
                                        newText = string.subString(textView.text,0,removePos) + string.subString(textView.text, removePos + 1)
                                    }
                                    else
                                    {
                                        return 
                                    }
                                }
                                else
                                {
                                    return
                                }
                            }
                            else
                            {
                                newText = string.subString(textView.text, 0, string.length(textView.text) - 1)
                            }
                            updateText(textView, newText)
                        }
                    }
                    return true
                }
                [keys.keyCodes.escape] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown and (!isRepeat))
                    {
                        finishEditing(markupView, textView, false)
                    }
                }
                [keys.keyCodes.left] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown)
                    {
                        cursorChanged(textView, -1, nil)
                    }
                }
                [keys.keyCodes.right] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown)
                    {
                        cursorChanged(textView, 1, nil)
                    }
                }
                #[keyMapping:getMappingIndex("textEntry", "newline")] = function(isDown, isRepeat)
                #    if(isDown)
                #    {
                #        newText = textView.text .. "\n"
                #        updateText(textView, newText)
                #    }
                #    return true 
                #end,
                
                [keys.keyCodes.delete] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown)
                    {
                        if(textView.text and string.length(textView.text) > 0)
                        {
                            newText = ""
                            if(textView.cursorOffset and textView.cursorOffset != 0)
                            {
                                textLength = string.length(textView.text)
                                if(textLength > 0)
                                {
                                    removePos = math.max(textLength + textView.cursorOffset, 0)
                                    if(removePos < textLength)
                                    {
                                        newText = string.subString(textView.text, 0, removePos) + string.subString(textView.text, removePos + 1)
                                        textView.cursorOffset = textView.cursorOffset + 1
                                    }
                                    else
                                    {
                                        return 
                                    }
                                }
                                else
                                {
                                    return
                                }
                            }

                            updateText(textView, newText)
                        }
                    }
                }

                [keys.keyCodes.escape] = function(isDown, keyCode, modCode, isRepeat)
                {
                    if(isDown and !isRepeat)
                    {
                        finishEditing(markupView, textView, false)
                    }
                }
            #todo [keyMapping:getMappingIndex("textEntry", "prevCommand")] = function(isDown, isRepeat) if(isDown then cursorChanged(textView, nil, 1) end return true end,
            #[keyMapping:getMappingIndex("textEntry", "nextCommand")] = function(isDown, isRepeat) if(isDown then cursorChanged(textView, nil, -1) end return true end,
                
            }

            keyChanged = function(isDown, keyCode, modCode, isRepeat)
            {
                func = keyMap[keyCode]
                if(func)
                {
                    func(isDown, keyCode, modCode, isRepeat)
                }
            }

            textEntry = function(text)
            {
                newText = text
                if(textView.text)
                {
                    if(textView.cursorOffset < 0)
                    {
                        textLength = string.length(textView.text)
                        if(textLength > 0)
                        {
                            insertAfterPos = math.max(textLength + textView.cursorOffset, 0)
                            newText = stringInsert(textView.text, text, insertAfterPos)
                        }
                    }
                    else
                    {
                        newText = textView.text + text
                    }
                }
                updateText(textView, newText)
            }
            
            textView.textEntryListenerID = eventManager.setTextEntryListener(textEntry, keyChanged)

            if(textView.onStartedEditing)
            {
                textView.onStartedEditing()
            }
        }
    }
}

getRowView = function(markupView)
{
    if(!markupView.currentRowView)
    {
        rowLayout = {
            type = "view"
            size = vec2(markupView.padding.left,minLineHeight)
        }
        markupView.currentRowView = markupView.scrollView.addView(rowLayout)
        markupView.preventWordSeparation = false
    }
    return markupView.currentRowView
}

addItemView = function(markupView, style)
{
    lineData = markupView.lineData
    rowView = getRowView(markupView)
    #print("addItemView:", lineData.foundText)

    textViewLayout = table.clone(textLayout)
    textViewLayout.id = "textView"

    if(markupView.isHeader)
    {
        textViewLayout.font = boldFont
        textViewLayout.fontSize = headerFontSize
    }

    if(markupView.bold)
    {
        textViewLayout.font = boldFont
    }
    else if(markupView.italic)
    {
        textViewLayout.font = italicFont
    }

    if(markupView.monospace)
    {
        textViewLayout.font = monoFont
    }

    link = false
    backgroundLayout = false

    if(style)
    {
        if(style.link)
        {
            link = style.link
            textViewLayout.color = linkColor
            textViewLayout.font = boldFont
            
            backgroundLayout = {
                type = "button"
                buttonType = "color"
                color = vec4(0.0,0.0,0.2,0.4)
                alignmentX = "left"
                alignmentY = "bottom"
                subviews = {
                    textViewLayout
                }
            }

            if(style.backgroundColor)
            {
                backgroundLayout.color = style.backgroundColor
            }
        }
        else if(style.backgroundColor)
        {
            backgroundLayout = {
                type = "color"
                color = style.backgroundColor
                alignmentX = "left"
                alignmentY = "bottom"
                subviews = {
                    textViewLayout
                }
            }
        }

        if(style.header)
        {
            textViewLayout.font = boldFont
            textViewLayout.fontSize = headerFontSize
        }

        if(style.bold)
        {
            textViewLayout.font = boldFont
        }
        else if(style.italic)
        {
            textViewLayout.font = italicFont
        }

        if(style.monospace)
        {
            textViewLayout.font = monoFont
        }

        if(style.font)
        {
            textViewLayout.font = style.font
        }

        if(style.fontSize)
        {
            textViewLayout.fontSize = style.fontSize
        }

        if(style.color)
        {
            textViewLayout.color = style.color
        }

    }

    if(!backgroundLayout)
    {
        backgroundLayout = {
            type = "view"
            alignmentX = "left"
            alignmentY = "bottom"
            subviews = {
                textViewLayout
            }
        }
    }

    if(style)
    {
        backgroundLayout.id = style.id
    }
    
    backgroundView = rowView.addView(backgroundLayout)

    textView = backgroundView.getView("textView")

    backgroundView.textView = textView #button.tui uses this

    textView.wrapWidth = markupView.parentSize.x - rowView.size.x - markupView.padding.left - 20
    textView.wrapClamp = true
    textView.preventWordSeparation = markupView.preventWordSeparation
    textView.text = lineData.foundText

    backgroundView.click = function(mouseLoc)
    {
        if(link)
        {
            if(type(link) == "function")
            {
                link()
            }
            else
            {
                katipo.linkClicked(link)
            }
        }
        textBackgroundViewClickFunction(markupView, textView, mouseLoc)
    }

    backgroundView.clickOutside = function()
    {
        finishEditing(markupView, textView, false)
    }

    markupView.preventWordSeparation = true #we allow word separation for the first item in the row only

    backgroundView.pos = vec3(rowView.size.x, 0, 0)

    rowView.size = vec2(rowView.size.x + textView.size.x, 
                            math.max(textView.size.y, rowView.size.y))


    

    backgroundView.size = textView.size

    #if(link)
    #{
    #    createLinkButton(backgroundView, link)
    #}

    addedTextLength = string.length(textView.text)
    totalTextLength = string.length(lineData.foundText)

    #print("addedTextLength:", addedTextLength, " totalTextLength:", totalTextLength)

    if(addedTextLength < totalTextLength)
    {
        markupView.currentRowView = nil #finish current row #bug, this is not sticking
        if(addedTextLength != 0)
        {
            remainingText = string.subString(lineData.foundText, addedTextLength)

            startIndex = 0
            innerCharFunc = function(charText, charIndex){
                if(charText != " ")
                {
                    .startIndex = charIndex
                    return true
                }
            }

            string.eachChar(remainingText, innerCharFunc)

            if(startIndex != 0)
            {
                lineData.foundText = string.subString(remainingText, startIndex)
            }
            else
            {
                lineData.foundText = remainingText
            }
        }

        addItemView(markupView, style)
    }
}

renderCapture = function(markupView, capture, parentStyle)
{
    lineData = markupView.lineData
    remainingText = lineData.foundText
    style = {}
    if(parentStyle)
    {
        for(k,v in parentStyle)
        {
            style[k] = v
        }
    }
    loadedValue = load(capture.markupString, scene)
    #print("in renderCapture loadedValue:", loadedValue, " from string:", capture.markupString)
    if(type(loadedValue) == "table")
    {
        for(k,v in loadedValue)
        {
            style[k] = v

            if(k == "id")
            {
                if(markupView.styles)
                {
                    idStyle = markupView.styles[v]
                    if(type(idStyle) == "table")
                    {
                        for(idK,idV in idStyle)
                        {
                            style[idK] = idV
                        }
                    }
                }
            }
        }
    }

    for(item in capture.items)
    {
        if(type(item) == "string")
        {
            lineData.foundText = item
            addItemView(markupView, style)
        }
        else
        {
            renderCapture(markupView, item, style)
        }
    }
    lineData.foundText = remainingText
}

charFunc = function(markupView, charText, charIndex)
{ 
    lineData = markupView.lineData
    if(lineData.captureClosedAwaitingParenthesis)
    {
        if(charText != "(")
        {
            print("error: expected '('")
            return true
        }
        lineData.parenthesisStackCount = 1
        lineData.foundMarkupCodeString = ""
        lineData.captureClosedAwaitingParenthesis = false
    }
    else if(lineData.parenthesisStackCount > 0)
    {
        if(charText == ")")
        {
            lineData.parenthesisStackCount--
            if(lineData.parenthesisStackCount == 0)
            {
                #print("found markup:", lineData.foundMarkupCodeString)
                currentCapture = lineData.currentCapture
                if(currentCapture)
                {
                    currentCapture.markupString = lineData.foundMarkupCodeString
                    parentCapture = currentCapture.parentCapture
                    currentCapture.parentCapture = nil

                    if(currentCapture.currentText)
                    {
                        table.insert(currentCapture.items, currentCapture.currentText)
                        currentCapture.currentText = nil
                    }
                    if(!parentCapture)
                    {
                        renderCapture(markupView, currentCapture)
                    }
                    lineData.currentCapture = parentCapture
                }
                else
                {
                    print("todo set line style")
                }
            }
        }
        else if(charText == "(")
        {
            lineData.parenthesisStackCount++
        }

        if(lineData.parenthesisStackCount != 0) 
        {
            lineData.foundMarkupCodeString += charText
        }
    }
    else if(charText == "[")
    {
        prevCapture = lineData.currentCapture
        lineData.currentCapture = {
            parentCapture = prevCapture
            items = {}
        }

        if(prevCapture)
        {
            if(prevCapture.currentText)
            {
                table.insert(prevCapture.items, prevCapture.currentText)
                prevCapture.currentText = nil
            }

            table.insert(prevCapture.items, lineData.currentCapture)
        }
        else
        {
            if(string.length(lineData.foundText) > 0)
            {
                addItemView(markupView, nil)
                lineData.foundText = ""
            }
        }
    }
    else if(charText == "]")
    {
        lineData.captureClosedAwaitingParenthesis = true
    }
    else
    {
        if(lineData.currentCapture)
        {
            if(!lineData.currentCapture.currentText)
            {
                lineData.currentCapture.currentText = charText
            }
            else
            {
                lineData.currentCapture.currentText += charText
            }
        }
        else if(charText == "*")
        {
            if(markupView.italic or markupView.bold)
            {
                if(lineData.starCount > 0 or markupView.italic)
                {
                    addItemView(markupView)
                    lineData.foundText = ""
                    markupView.italic = nil
                    markupView.bold = nil
                    lineData.starCount = 0
                }
                else
                {
                    lineData.starCount++
                }
            }
            else
            {
                lineData.starCount++
            }
        }
        else if(charText == "`")
        {
            if(markupView.monospace)
            {
                addItemView(markupView)
                lineData.foundText = ""
                markupView.monospace = nil
                lineData.backtickCount = 0
            }
            else
            {
                lineData.backtickCount++
            }
        }
        else if(lineData.onlyFoundSpace)
        {
            if(charText == "(")
            {
                lineData.parenthesisStackCount = 1
                lineData.foundMarkupCodeString = ""
                lineData.skipLeadingSpace = true
            }
            else if(charText == "#")
            {
                markupView.isHeader = true
                lineData.skipLeadingSpace = true
            }
            else
            {
                if(charText != " ")
                {
                    lineData.onlyFoundSpace = false
                    lineData.foundText += charText
                }
                else if(!lineData.skipLeadingSpace)
                {
                    lineData.foundText += charText
                }

            }
        }
        else
        {
            if(lineData.starCount > 0)
            {
                if(string.length(lineData.foundText) > 0)
                {
                    addItemView(markupView)
                    lineData.foundText = ""
                }

                if(lineData.starCount > 1)
                {
                    markupView.bold = true
                }
                else
                {
                    markupView.italic = true
                }
                lineData.starCount = 0
            }

            if(lineData.backtickCount > 0)
            {
                if(string.length(lineData.foundText) > 0)
                {
                    addItemView(markupView)
                    lineData.foundText = ""
                }
                markupView.monospace = true
                lineData.backtickCount = 0
            }

            lineData.foundText += charText
        }
    }
}

lineFunc = function(markupView, lineText)
{
    lineData = {
        onlyFoundSpace = true
        foundMarkupCodeString = ""
        foundText = ""
        parenthesisStackCount = 0
        starCount = 0
        backtickCount = 0
    }

    markupView.lineData = lineData

    markupView.isHeader = nil
    markupView.bold = nil
    markupView.italic = nil
    markupView.monospace = nil
    
    localCharFunc = function(charText, charIndex)
    {
        return charFunc(markupView, charText, charIndex)
    }

    string.eachChar(lineText, localCharFunc)

    addItemView(markupView)
    markupView.currentRowView = nil #finish current row
}

create = function(parentView, viewLayout)
{
    layout = getViewLayout(viewLayout)
    markupView = parentView.addView(layout)

    scrollViewLayout = {
        size = viewLayout.size
    }
    scrollViewLayout.type = "scrollView"

    markupScrollView = markupView.addView(scrollViewLayout)
    markupView.scrollView = markupScrollView
    
    cursorViewLayout = {
        size = vec2(1,minLineHeight)
        type = "color"
        color = vec4(1.0,1.0,1.0,1.0)
        horizontalAlignment = "left"
        verticalAlignment = verticalAlignment
        pos = vec3(2,1,0)
    }
    
    cursorView = markupView.addView(cursorViewLayout)
    cursorView.hidden = true
    markupView.cursorView = cursorView

    markupView.padding = {
        top = topPaddingDefault
        left = leftPaddingDefault
    }

    markupScrollView.markupPadding = markupView.padding
    
    if(viewLayout.markupPadding)
    {
        for(k,v in viewLayout.markupPadding)
        {
            markupScrollView.markupPadding[k] = v
        }
    }

    localLineFunc = function(line)
    {
        return lineFunc(markupView, line)
    }

    doSetText = function(markupText)
    {
        markupScrollView.removeAllRows()
        markupScrollView.currentText = markupText

        topPaddingLayout = {
            type = "view"
            size = vec2(markupView.padding.top,markupView.padding.top)
        }

        markupScrollView.addView(topPaddingLayout)

        if(markupText)
        {
            string.eachLine(markupText, localLineFunc)
        }

        if(markupScrollView.variableHeight)
        {
            markupScrollView.layoutRows()
            markupView.size = vec2(markupScrollView.size.x, math.max(markupScrollView.totalHeight, minLineHeight))
            #markupView.size = markupScrollView.size
        }
    } 

    markupView.setText = doSetText

    markupView.onParentSizeChanged = function(parentSize) #override the scrollView one with our own
    {
        markupScrollView.layoutRows()
        markupScrollView.parentSize = parentSize
        markupScrollView.size = parentSize

        markupView.size = parentSize
        markupView.parentSize = parentSize

        doSetText(markupScrollView.currentText)
    }



    return markupView
}