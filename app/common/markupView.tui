
topPadding = 20
itemRowXPadding = 20
lineHeight = 20

topPaddingLayout = {
    type = "view"
    size = vec2(topPadding,topPadding)
}

textLayout = {
    type = "text"
    font = "roboto"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

boldTextLayout = {
    type = "text"
    font = "robotoBold"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

monoTextLayout = {
    type = "text"
    font = "robotoMono"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

italicTextLayout = {
    type = "text"
    font = "robotoItalic"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

headerTextLayout = {
    type = "text"
    font = "robotoBold"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 26
}

getViewLayout = function(incomingLayout)
{
    #print("incomingLayout:", incomingLayout)
    layout = {}
    for(k,v in incomingLayout)
    {
        layout[k] = v
    }

    layout.type = "scrollView"
    
    return layout
}

loadMarkupCode = function(lineText) #assumes "(" is first char
{

}


create = function(parentView, viewLayout)
{
    #print("viewLayout:", viewLayout)
    layout = getViewLayout(viewLayout)
    #print("viewLayout b:", layout)
    markupScrollView = parentView.addView(layout)

    doSetText = function(markupText)
    {
        markupScrollView.removeAllRows()
        markupScrollView.currentText = markupText

        topPaddingView = markupScrollView.addView(topPaddingLayout)

        lineFunc = function(lineText)
        {
            itemLayout = textRowLayout
            
            onlyFoundSpace = true
            skipLeadingSpace = false
            foundMarkupCodeString = ""
            foundText = ""
            parenthesisStackCount = 0
            starCount = 0
            backtickCount = 0
            currentRowView = false
            preventWordSeparation = false

            isHeader = false
            italic = false
            bold = false
            monospace = false
            

            getRowView = function()
            {
                if(!currentRowView)
                {
                    rowLayout = {
                        type = "view"
                        size = vec2(itemRowXPadding,lineHeight)
                    }
                    .currentRowView = markupScrollView.addView(rowLayout)
                    .preventWordSeparation = false
                }
                return currentRowView
            }

            addItemView = function()
            {
                rowView = getRowView()
                #print("addItemView:", foundText)

                layout = textLayout
                if(isHeader)
                {
                    layout = headerTextLayout
                }
                else if(bold)
                {
                    layout = boldTextLayout
                }
                else if(italic)
                {
                    layout = italicTextLayout
                }
                else if(monospace)
                {
                    layout = monoTextLayout
                }
                
                textView = rowView.addView(layout)
                textView.wrapWidth = markupScrollView.parentSize.x - rowView.size.x - itemRowXPadding - 20
                textView.wrapClamp = true
                textView.preventWordSeparation = preventWordSeparation
                textView.text = foundText
                textView.pos = vec3(rowView.size.x, 0, 0)

                .preventWordSeparation = true #we allow word separation for the first item in the row only

                rowView.size = vec2(rowView.size.x + textView.size.x, 
                                      math.max(textView.size.y, rowView.size.y))

                addedTextLength = string.length(textView.text)
                totalTextLength = string.length(foundText)
                if(addedTextLength < totalTextLength)
                {
                    .currentRowView = false #finish current row
                    remainingText = string.subString(foundText, addedTextLength)

                    startIndex = 0
                    string.eachChar(remainingText, function(charText, charIndex){
                        if(charText != " ")
                        {
                            .startIndex = charIndex
                            return true
                        }
                    })

                    if(startIndex != 0)
                    {
                        .foundText = string.subString(remainingText, startIndex)
                    }
                    else
                    {
                        .foundText = remainingText
                    }
                    addItemView()
                }
            }
            

            charFunc = function(charText, charIndex)
            {
                if(parenthesisStackCount > 0)
                {
                    if(charText == "(")
                    {
                        parenthesisStackCount++
                    }
                    else if(charText == ")")
                    {
                        parenthesisStackCount--
                        if(parenthesisStackCount == 0)
                        {
                            #print("found markup:", foundMarkupCodeString)
                        }
                    }
                    .foundMarkupCodeString = foundMarkupCodeString + charText
                }
                else
                {
                    if(charText == "*")
                    {
                        if(italic or bold)
                        {
                            if(starCount > 0 or italic)
                            {
                                addItemView()
                                .foundText = ""
                                .italic = false
                                .bold = false
                                .starCount = 0
                            }
                            else
                            {
                                starCount++
                            }
                        }
                        else
                        {
                            starCount++
                        }
                    }
                    else if(charText == "`")
                    {
                        if(monospace)
                        {
                            addItemView()
                            .foundText = ""
                            .monospace = false
                            .backtickCount = 0
                        }
                        else
                        {
                            backtickCount++
                        }
                    }
                    else if(onlyFoundSpace)
                    {
                        if(charText == "(")
                        {
                            .parenthesisStackCount = 1
                            .foundMarkupCodeString = ""
                            .skipLeadingSpace = true
                        }
                        else if(charText == "#")
                        {
                            .isHeader = true
                            .skipLeadingSpace = true
                        }
                        else
                        {
                            if(charText != " ")
                            {
                                .onlyFoundSpace = false
                                foundText += charText
                            }
                            else if(!skipLeadingSpace)
                            {
                                foundText += charText
                            }

                        }
                    }
                    else
                    {
                        if(starCount > 0)
                        {
                            if(string.length(foundText) > 0)
                            {
                                addItemView()
                                .foundText = ""
                            }

                            if(starCount > 1)
                            {
                                .bold = true
                            }
                            else
                            {
                                .italic = true
                            }
                            .starCount = 0
                        }

                        if(backtickCount > 0)
                        {
                            if(string.length(foundText) > 0)
                            {
                                addItemView()
                                .foundText = ""
                            }
                            .monospace = true
                            .backtickCount = 0
                        }

                        foundText += charText
                    }
                }
            }


            string.eachChar(lineText, charFunc)

            addItemView()
            .currentRowView = false #finish current row
            .isHeader = false
            
        }

        if(markupText)
        {
            string.eachLine(markupText, lineFunc)
        }
    }

    markupScrollView.setText = doSetText

    markupScrollView.onParentSizeChanged = function(parentSize) #override the scrollView one with our own
    {
        markupScrollView.parentSize = parentSize
        doSetText(markupScrollView.currentText)
        return parentSize
    }

    return markupScrollView
}