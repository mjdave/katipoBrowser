
topPaddingDefault = 20
leftPaddingDefault = 20 #we don't support bottom or right padding yet
minLineHeight = 20


font = "roboto"
boldFont = "robotoBold"
italicFont = "robotoItalic"
monoFont = "robotoMono"
fontSize = 16
headerFontSize = 26

linkColor = vec4(0.5,0.8,1.0,1.0)
onLinkClick = false

textLayout = {
    type = "text"
    font = "roboto"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

boldTextLayout = {
    type = "text"
    font = "robotoBold"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

monoTextLayout = {
    type = "text"
    font = "robotoMono"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

italicTextLayout = {
    type = "text"
    font = "robotoItalic"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 16
}

headerTextLayout = {
    type = "text"
    font = "robotoBold"
    alignmentX = "left"
    alignmentY = "bottom"
    fontSize = 26
}

getViewLayout = function(incomingLayout)
{
    #print("incomingLayout:", incomingLayout)
    layout = {}
    for(k,v in incomingLayout)
    {
        layout[k] = v
    }

    layout.type = "view"
    
    return layout
}

updateVisuals = function(view)
{
    if(view.mouseIsDown)
    {
        view.color = view.mouseDownColor
    }
    else if(view.isHover)
    {
        view.color = view.highlightColor
    }
    else
    {
        view.color = view.baseColor
    }
}

createLinkButton = function(view, link)
{
    if(!view.baseColor)
    {
        if(!view.color)
        {
            view.color = linkColor
        }
        view.baseColor = view.color
        view.highlightColor = view.baseColor + vec4(0.0,0.2,0.4,0.4)
        view.mouseDownColor = view.baseColor + vec4(0.5,0.5,0.5,0.5)
    }

    view.click = function()
    {
        katipo.linkClicked(link)
    }

    view.hoverStart = function()
    {
        view.isHover = true
        updateVisuals(view)
    }

    view.hoverEnd = function()
    {
        view.isHover = false
        updateVisuals(view)
    }

    view.mouseDown = function()
    {
        view.mouseIsDown = true
        updateVisuals(view)
    }

    view.mouseUp = function()
    {
        view.mouseIsDown = false
        updateVisuals(view)
    }

    updateVisuals(view)
}

getRowView = function(markupScrollView)
{
    if(!markupScrollView.currentRowView)
    {
        rowLayout = {
            type = "view"
            size = vec2(markupScrollView.markupPadding.left,minLineHeight)
        }
        markupScrollView.currentRowView = markupScrollView.addView(rowLayout)
        markupScrollView.preventWordSeparation = false
    }
    return markupScrollView.currentRowView
}

addItemView = function(markupScrollView, style)
{
    lineData = markupScrollView.lineData
    rowView = getRowView(markupScrollView)
    #print("addItemView:", lineData.foundText)

    layout = table.clone(textLayout)

    if(markupScrollView.isHeader)
    {
        layout.font = boldFont
        layout.fontSize = headerFontSize
    }

    if(markupScrollView.bold)
    {
        layout.font = boldFont
    }
    else if(markupScrollView.italic)
    {
        layout.font = italicFont
    }

    if(markupScrollView.monospace)
    {
        layout.font = monoFont
    }

    usesBackgroundColorView = false
    link = false

    if(style)
    {
        if(style.link)
        {
            link = style.link
            layout.color = linkColor
            layout.font = boldFont
            # add button view
        }

        if(style.header)
        {
            layout.font = boldFont
            layout.fontSize = headerFontSize
        }

        if(style.bold)
        {
            layout.font = boldFont
        }
        else if(style.italic)
        {
            layout.font = italicFont
        }

        if(style.monospace)
        {
            layout.font = monoFont
        }

        if(style.font)
        {
            layout.font = style.font
        }

        if(style.fontSize)
        {
            layout.fontSize = style.fontSize
        }

        if(style.color)
        {
            layout.color = style.color
        }

        if(style.backgroundColor)
        {
            usesBackgroundColorView = true
            textViewLayout = layout
            textViewLayout.id = "textView"
            
            layout = {
                type = "color"
                color = style.backgroundColor
                alignmentX = "left"
                alignmentY = "bottom"
                subviews = {
                    textViewLayout
                }
            }
        }
    }

    #print("layout:", layout)
    
    backgroundView = rowView.addView(layout)
    textView = nil
    if(usesBackgroundColorView)
    {
        textView = backgroundView.getView("textView")
    }
    else
    {
        textView = backgroundView
    }

    textView.wrapWidth = markupScrollView.parentSize.x - rowView.size.x - markupScrollView.markupPadding.left - 20
    textView.wrapClamp = true
    textView.preventWordSeparation = markupScrollView.preventWordSeparation
    textView.text = lineData.foundText

    markupScrollView.preventWordSeparation = true #we allow word separation for the first item in the row only

    backgroundView.pos = vec3(rowView.size.x, 0, 0)

    rowView.size = vec2(rowView.size.x + textView.size.x, 
                            math.max(textView.size.y, rowView.size.y))


    

    if(usesBackgroundColorView)
    {
        backgroundView.size = textView.size
    }

    if(link)
    {
        createLinkButton(backgroundView, link)
    }

    addedTextLength = string.length(textView.text)
    totalTextLength = string.length(lineData.foundText)

    #print("addedTextLength:", addedTextLength, " totalTextLength:", totalTextLength)

    if(addedTextLength < totalTextLength)
    {
        markupScrollView.currentRowView = nil #finish current row #bug, this is not sticking
        if(addedTextLength != 0)
        {
            remainingText = string.subString(lineData.foundText, addedTextLength)

            startIndex = 0
            innerCharFunc = function(charText, charIndex){
                if(charText != " ")
                {
                    .startIndex = charIndex
                    return true
                }
            }

            string.eachChar(remainingText, innerCharFunc)

            if(startIndex != 0)
            {
                lineData.foundText = string.subString(remainingText, startIndex)
            }
            else
            {
                lineData.foundText = remainingText
            }
        }

        addItemView(markupScrollView, style)
    }
}

renderCapture = function(markupScrollView, capture, parentStyle)
{
    lineData = markupScrollView.lineData
    remainingText = lineData.foundText
    style = {}
    if(parentStyle)
    {
        for(k,v in parentStyle)
        {
            style[k] = v
        }
    }
    loadedValue = load(capture.markupString, scene)
    #print("in renderCapture loadedValue:", loadedValue, " from string:", capture.markupString)
    if(type(loadedValue) == "table")
    {
        for(k,v in loadedValue)
        {
            style[k] = v
        }
    }

    for(item in capture.items)
    {
        if(type(item) == "string")
        {
            lineData.foundText = item
            addItemView(markupScrollView, style)
        }
        else
        {
            renderCapture(markupScrollView, item, style)
        }
    }
    lineData.foundText = remainingText
}

charFunc = function(markupScrollView, charText, charIndex)
{ 
    lineData = markupScrollView.lineData
    if(lineData.captureClosedAwaitingParenthesis)
    {
        if(charText != "(")
        {
            print("error: expected '('")
            return true
        }
        lineData.parenthesisStackCount = 1
        lineData.foundMarkupCodeString = ""
        lineData.captureClosedAwaitingParenthesis = false
    }
    else if(lineData.parenthesisStackCount > 0)
    {
        if(charText == ")")
        {
            lineData.parenthesisStackCount--
            if(lineData.parenthesisStackCount == 0)
            {
                #print("found markup:", lineData.foundMarkupCodeString)
                currentCapture = lineData.currentCapture
                if(currentCapture)
                {
                    currentCapture.markupString = lineData.foundMarkupCodeString
                    parentCapture = currentCapture.parentCapture
                    currentCapture.parentCapture = nil

                    if(currentCapture.currentText)
                    {
                        table.insert(currentCapture.items, currentCapture.currentText)
                        currentCapture.currentText = nil
                    }
                    if(!parentCapture)
                    {
                        renderCapture(markupScrollView, currentCapture)
                    }
                    lineData.currentCapture = parentCapture
                }
                else
                {
                    print("todo set line style")
                }
            }
        }
        else if(charText == "(")
        {
            lineData.parenthesisStackCount++
        }

        if(lineData.parenthesisStackCount != 0) 
        {
            lineData.foundMarkupCodeString += charText
        }
    }
    else if(charText == "[")
    {
        prevCapture = lineData.currentCapture
        lineData.currentCapture = {
            parentCapture = prevCapture
            items = {}
        }

        if(prevCapture)
        {
            if(prevCapture.currentText)
            {
                table.insert(prevCapture.items, prevCapture.currentText)
                prevCapture.currentText = nil
            }

            table.insert(prevCapture.items, lineData.currentCapture)
        }
        else
        {
            if(string.length(lineData.foundText) > 0)
            {
                addItemView(markupScrollView, nil)
                lineData.foundText = ""
            }
        }
    }
    else if(charText == "]")
    {
        lineData.captureClosedAwaitingParenthesis = true
    }
    else
    {
        if(lineData.currentCapture)
        {
            if(!lineData.currentCapture.currentText)
            {
                lineData.currentCapture.currentText = charText
            }
            else
            {
                lineData.currentCapture.currentText += charText
            }
        }
        else if(charText == "*")
        {
            if(markupScrollView.italic or markupScrollView.bold)
            {
                if(lineData.starCount > 0 or markupScrollView.italic)
                {
                    addItemView(markupScrollView)
                    lineData.foundText = ""
                    markupScrollView.italic = nil
                    markupScrollView.bold = nil
                    lineData.starCount = 0
                }
                else
                {
                    lineData.starCount++
                }
            }
            else
            {
                lineData.starCount++
            }
        }
        else if(charText == "`")
        {
            if(markupScrollView.monospace)
            {
                addItemView(markupScrollView)
                lineData.foundText = ""
                markupScrollView.monospace = nil
                lineData.backtickCount = 0
            }
            else
            {
                lineData.backtickCount++
            }
        }
        else if(lineData.onlyFoundSpace)
        {
            if(charText == "(")
            {
                lineData.parenthesisStackCount = 1
                lineData.foundMarkupCodeString = ""
                lineData.skipLeadingSpace = true
            }
            else if(charText == "#")
            {
                markupScrollView.isHeader = true
                lineData.skipLeadingSpace = true
            }
            else
            {
                if(charText != " ")
                {
                    lineData.onlyFoundSpace = false
                    lineData.foundText += charText
                }
                else if(!lineData.skipLeadingSpace)
                {
                    lineData.foundText += charText
                }

            }
        }
        else
        {
            if(lineData.starCount > 0)
            {
                if(string.length(lineData.foundText) > 0)
                {
                    addItemView(markupScrollView)
                    lineData.foundText = ""
                }

                if(lineData.starCount > 1)
                {
                    markupScrollView.bold = true
                }
                else
                {
                    markupScrollView.italic = true
                }
                lineData.starCount = 0
            }

            if(lineData.backtickCount > 0)
            {
                if(string.length(lineData.foundText) > 0)
                {
                    addItemView(markupScrollView)
                    lineData.foundText = ""
                }
                markupScrollView.monospace = true
                lineData.backtickCount = 0
            }

            lineData.foundText += charText
        }
    }
}

lineFunc = function(markupScrollView, lineText)
{
    lineData = {
        onlyFoundSpace = true
        foundMarkupCodeString = ""
        foundText = ""
        parenthesisStackCount = 0
        starCount = 0
        backtickCount = 0
    }

    markupScrollView.lineData = lineData

    markupScrollView.isHeader = nil
    markupScrollView.bold = nil
    markupScrollView.italic = nil
    markupScrollView.monospace = nil
    
    localCharFunc = function(charText, charIndex)
    {
        return charFunc(markupScrollView, charText, charIndex)
    }

    string.eachChar(lineText, localCharFunc)

    addItemView(markupScrollView)
    markupScrollView.currentRowView = nil #finish current row
}

create = function(parentView, viewLayout)
{
    layout = getViewLayout(viewLayout)
    markupView = parentView.addView(layout)

    scrollViewLayout = table.clone(viewLayout) #may not be desirable?
    scrollViewLayout.type = "scrollView"

    markupScrollView = markupView.addView(scrollViewLayout)
    markupView.scrollView = markupScrollView
    
    cursorViewLayout = {
        size = vec2(1,minLineHeight)
        type = "color"
        color = vec4(1.0,1.0,1.0,1.0)
        horizontalAlignment = "left"
        verticalAlignment = verticalAlignment
        pos = vec3(2,1,0)
    }
    
    cursorView = markupView.addView(cursorViewLayout)
    cursorView.hidden = true
    markupView.cursorView = cursorView

    markupScrollView.markupPadding = {
        top = topPaddingDefault
        left = leftPaddingDefault
    }
    
    if(viewLayout.markupPadding)
    {
        for(k,v in viewLayout.markupPadding)
        {
            markupScrollView.markupPadding[k] = v
        }
    }

    localLineFunc = function(line)
    {
        return lineFunc(markupScrollView, line)
    }

    doSetText = function(markupText)
    {
        markupScrollView.removeAllRows()
        markupScrollView.currentText = markupText


        topPaddingLayout = {
            type = "view"
            size = vec2(markupScrollView.markupPadding.top,markupScrollView.markupPadding.top)
        }

        markupScrollView.addView(topPaddingLayout)

        if(markupText)
        {
            string.eachLine(markupText, localLineFunc)
        }

        if(markupScrollView.variableHeight)
        {
            markupScrollView.layoutRows()
            markupView.size = vec2(markupScrollView.size.x, math.max(markupScrollView.totalHeight, minLineHeight))
            #markupView.size = markupScrollView.size
        }
    } 

    markupView.setText = doSetText

    markupView.onParentSizeChanged = function(parentSize) #override the scrollView one with our own
    {
        markupScrollView.layoutRows()
        markupScrollView.parentSize = parentSize
        markupView.size = parentSize
        markupScrollView.size = parentSize
        doSetText(markupScrollView.currentText)
    }


    return markupView
}