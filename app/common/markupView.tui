getViewLayout = function(incomingLayout)
{
    #print("incomingLayout:", incomingLayout)
    layout = {}
    for(k,v in incomingLayout)
    {
        layout[k] = v
    }

    layout.type = "view"
    
    return layout
}



updateEditingText = function(markupView, newText)
{
    textView = markupView.currentEditingTextView
    if(!textView)
    {
        return
    }

    if(textView.captureStartCharacterIndex)
    {
        beforeText = string.subString(markupView.currentMarkupText, 0, textView.captureStartCharacterIndex + 1)
        afterText = string.subString(markupView.currentMarkupText, textView.captureStartCharacterIndex + 1 + string.length(textView.text))
        markupView.currentMarkupText = beforeText + newText + afterText
        reloadText(markupView)
    }

    #todo we need to get the new text view, it might have changed
    #{
    #    markupView.cursorView.hidden = false
    #    markupView.cursorTimer = 0.0
#
    #    updateCursorPosition(markupView)
    #}
    #
    #if(textView.textEntryChangedContinuousFunction)
    #{
    #    textView.textEntryChangedContinuousFunction(textView.text)
    #}
}

finishEditing = function(markupView, confirmChanges)
{
    textView = markupView.currentEditingTextView
    if(!textView)
    {
        return
    }

    print("finish editing:", textView.text)
    debug.backtrace()
    markupView.currentEditingTextView = nil
    markupView.currentEditingTextViewCaptureStartCharacterIndex = nil

    markupView.cursorView.hidden = true
    
    eventManager.removeTextEntryListener(markupView.textEntryListenerID)
    markupView.textEntryListenerID = nil

    if((!textView.text) or string.length(textView.text) == 0)
    {
        if(markupView.allowsEmpty)
        {
            textView.styleTextEntryFunction("", confirmChanges)
        }
        else
        {
            updateEditingText(markupView, markupView.editStartTextValue)
            textView.styleTextEntryFunction(markupView.editStartTextValue, false)
        }
    }
    else
    {
        if(!confirmChanges and markupView.requireEnterToConfirm) #requireEnterToConfirm means we should revert if !confirmChanges
        {
            updateEditingText(markupView, markupView.editStartTextValue)
            textView.styleTextEntryFunction(textView.text, false)
        }
        else
        {
            textView.styleTextEntryFunction(textView.text, confirmChanges)
        }
    }
}

updateCursorFunction = function(markupView, dt)
{
    if(markupView.currentEditingTextView)
    {
        markupView.cursorTimer = markupView.cursorTimer + dt
        if(markupView.cursorTimer > 0.5)
        {
            markupView.cursorTimer = markupView.cursorTimer - 0.5
            if(markupView.cursorTimer > 0.5)
            {
                markupView.cursorTimer = 0.0
            }
            markupView.cursorView.hidden = (!markupView.cursorView.hidden)
        }
    }
}

updateCursorPosition = function(markupView)
{
    textView = markupView.currentEditingTextView
    if(!textView)
    {
        return
    }

    #print("textView:", textView)
    rect = textView.getRectForCharAtIndex(-1 + markupView.cursorOffset)
    #print("rect:", rect, " markupView.cursorOffset:", markupView.cursorOffset)
    xOffset = rect.x + rect.z

    if(textView.horizontalAlignment == "center")
    {
        xOffset /= 2
    }
    
    #todo handle right alignment
    #print("set cursor pos:", xOffset + 1,",",rect.y + 1,0)
    markupView.cursorView.pos = vec3(xOffset + 1,rect.y + 1,0)
}

keyMap = {
    [keys.keyCodes.key_return] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown)
        {
            if(modCode == keys.modifiers.shift)
            {
                updateEditingText(markupView, markupView.currentEditingTextView.text + "\n")
            }
            else if(!isRepeat)
            {
                finishEditing(markupView, true)
            }
        }
    }
    [keys.keyCodes.backspace] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown)
        {
            textView = markupView.currentEditingTextView
            if(textView.text and string.length(textView.text) > 0)
            {
                newText = ""
                if(markupView.cursorOffset and markupView.cursorOffset != 0)
                {
                    textLength = string.length(textView.text)
                    if(textLength > 0)
                    {
                        removePos = math.max(textLength + markupView.cursorOffset, 0)
                        if(removePos >= 0)
                        {
                            newText = string.subString(textView.text,0,removePos) + string.subString(textView.text, removePos + 1)
                        }
                        else
                        {
                            return 
                        }
                    }
                    else
                    {
                        return
                    }
                }
                else
                {
                    newText = string.subString(textView.text, 0, string.length(textView.text) - 1)
                }
                updateEditingText(markupView, newText)
            }
        }
        return true
    }
    [keys.keyCodes.escape] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown and (!isRepeat))
        {
            finishEditing(markupView, false)
        }
    }
    [keys.keyCodes.left] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown)
        {
            #cursorChanged(markupView, -1, nil) todo
        }
    }
    [keys.keyCodes.right] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown)
        {
            #cursorChanged(markupView, 1, nil) todo
        }
    }
    #[keyMapping:getMappingIndex("textEntry", "newline")] = function(isDown, isRepeat)
    #    if(isDown)
    #    {
    #        newText = textView.text .. "\n"
    #        updateEditingText(textView, newText)
    #    }
    #    return true 
    #end,
    
    [keys.keyCodes.delete] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown)
        {
            textView = markupView.currentEditingTextView
            if(textView.text and string.length(textView.text) > 0)
            {
                newText = ""
                if(markupView.cursorOffset and markupView.cursorOffset != 0)
                {
                    textLength = string.length(textView.text)
                    if(textLength > 0)
                    {
                        removePos = math.max(textLength + markupView.cursorOffset, 0)
                        if(removePos < textLength)
                        {
                            newText = string.subString(textView.text, 0, removePos) + string.subString(textView.text, removePos + 1)
                            markupView.cursorOffset = markupView.cursorOffset + 1
                        }
                        else
                        {
                            return 
                        }
                    }
                    else
                    {
                        return
                    }
                }

                updateEditingText(markupView, newText)
            }
        }
    }

    [keys.keyCodes.escape] = function(markupView, isDown, keyCode, modCode, isRepeat)
    {
        if(isDown and !isRepeat)
        {
            finishEditing(markupView, false)
        }
    }
#todo [keyMapping:getMappingIndex("textEntry", "prevCommand")] = function(isDown, isRepeat) if(isDown then cursorChanged(textView, nil, 1) end return true end,
#[keyMapping:getMappingIndex("textEntry", "nextCommand")] = function(isDown, isRepeat) if(isDown then cursorChanged(textView, nil, -1) end return true end,
    
}

textBackgroundViewClickFunction = function(markupView, textView, mouseLoc)
{
    if(!textView.styleTextEntryFunction)
    {
        return
    }
    if(!markupView.disabled)
    {
        if(markupView.currentEditingTextView == textView)
        {
            print("todo, allow cursor position change with click")
            /*if(textView.text)
            {
                textViewLoc = textView:locationRelativeToView(mouseLoc, textView.textView)

                charIndex = textView.textView:getCharIndexForPos(textViewLoc)
                textLength = string.length(textView.text)
                if(textLength > 0)
                {
                    charIndex = mjm.clamp(charIndex, 0, textLength)
                    markupView.cursorOffset = charIndex - textLength
                    markupView.cursorView.hidden = false
                    markupView.cursorTimer = 0.0
                    updateCursorPosition(markupView)
                    textView.textView.resetVerticalCursorMovementAnchors()
                }
            }*/
            #mj:log("mouseLoc:", mouseLoc - vec2(textView.pos.x, textView.pos.y), " charIndex:", charIndex)
        }
        else
        {
            markupView.currentEditingTextView = textView
            markupView.currentEditingTextViewCaptureStartCharacterIndex = textView.captureStartCharacterIndex

            #textView.textView:resetVerticalCursorMovementAnchors()
            markupView.editStartTextValue = textView.text
            markupView.cursorView.hidden = false
            markupView.cursorView.layoutParent = textView
            markupView.cursorTimer = 0.0

            markupView.cursorOffset = 0

            print("start editing:", textView.text)

            updateCursorPosition(markupView)

            keyChanged = function(isDown, keyCode, modCode, isRepeat)
            {
                func = keyMap[keyCode]
                if(func)
                {
                    func(markupView, isDown, keyCode, modCode, isRepeat)
                }
            }

            textEntry = function(text)
            {
                currentEditingTextView = markupView.currentEditingTextView #we cannot use textView directly, it may be replaced
                newText = text
                if(currentEditingTextView.text)
                {
                    if(markupView.cursorOffset < 0)
                    {
                        textLength = string.length(currentEditingTextView.text)
                        if(textLength > 0)
                        {
                            insertAfterPos = math.max(textLength + markupView.cursorOffset, 0)
                            newText = stringInsert(currentEditingTextView.text, text, insertAfterPos)
                        }
                    }
                    else
                    {
                        newText = currentEditingTextView.text + text
                    }
                }
                updateEditingText(markupView, newText)
            }
            
            markupView.textEntryListenerID = eventManager.setTextEntryListener(textEntry, keyChanged)

            if(markupView.onStartedEditing)
            {
                markupView.onStartedEditing()
            }
        }
    }
}

finishCurrentRow = function(markupView)
{
    clearAnyRemainingCachedItemsFromCurrentRow(markupView)
    parser = markupView.parser
    if(parser.currentRowInfo)
    {
        parser.cacheRowIndex++
        parser.currentRowInfo = nil
    }
}

getRowView = function(markupView)
{
    parser = markupView.parser
    if(!parser.currentRowInfo)
    {
        #print("getRowView parser.cacheRowIndex:", parser.cacheRowIndex)
        #print("table.count(markupView.cachedRows):", table.count(markupView.cachedRows))
        if(table.count(markupView.cachedRows) > parser.cacheRowIndex)
        {
            parser.currentRowInfo = markupView.cachedRows[parser.cacheRowIndex]
        }
        else
        {
            rowLayout = {
                type = "view"
                size = vec2(markupView.padding.left,minLineHeight)
            }

            parser.currentRowInfo = {
                view = markupView.scrollView.addView(rowLayout)
                items = {}
            }
            table.insert(markupView.cachedRows, parser.currentRowInfo)
        }
        
        parser.cacheItemIndex = 0
        parser.cacheRowWidthAccumulator = markupView.padding.left
        
    }
    return parser.currentRowInfo.view
}

addItemView = false

addNextRowForWrapOverflow = function(markupView, style, addedTextLength)
{
    #print("addNextRowForWrapOverflow")
    parser = markupView.parser
    finishCurrentRow(markupView)
    if(addedTextLength != 0)
    {
        remainingText = string.subString(parser.foundText, addedTextLength)

        startIndex = 0
        innerCharFunc = function(charText, charIndex){
            if(charText != " ")
            {
                .startIndex = charIndex
                return true
            }
        }

        string.eachChar(remainingText, innerCharFunc)

        if(startIndex != 0)
        {
            parser.foundText = string.subString(remainingText, startIndex)
        }
        else
        {
            parser.foundText = remainingText
        }
    }

    #print("adding:", parser.foundText)

    addItemView(markupView, style)
}



clearAnyRemainingCachedItemsFromCurrentRow = function(markupView)
{
    parser = markupView.parser
    rowInfo = parser.currentRowInfo
    if(!rowInfo)
    {
        return
    }

    rowView = rowInfo.view

    if(parser.cacheItemIndex < table.count(rowInfo.items))
    {
        #print("parser.cacheItemIndex:",parser.cacheItemIndex," < table.count(rowInfo.items):", table.count(rowInfo.items))
        #startPos = rowInfo.items[parser.cacheItemIndex].xPos
        for(i = table.count(rowInfo.items) - 1, i >= parser.cacheItemIndex, i--)
        {
            itemCache = rowInfo.items[i]
            #print("remove:", itemCache)
            rowView.removeView(itemCache.backgroundView)
            table.remove(rowInfo.items, i)
        }
    }
}

addItemView = function(markupView, style, captureStartCharacterIndex)
{
    if(style and style.hidden)
    {
        return
    }
    parser = markupView.parser

    if(parser.foundText == "\n")
    {
        finishCurrentRow(markupView)
        getRowView(markupView) #generate a new row, to add a newline
        return
    }

    rowView = getRowView(markupView)


    #print("addItemView:", parser.foundText)

    textViewLayout = table.clone(textLayout)
    textViewLayout.id = "textView"

    if(parser.isHeader)
    {
        textViewLayout.font = boldFont
        textViewLayout.fontSize = headerFontSize
    }

    if(parser.bold)
    {
        textViewLayout.font = boldFont
    }
    else if(parser.italic)
    {
        textViewLayout.font = italicFont
    }

    if(parser.monospace)
    {
        textViewLayout.font = monoFont
    }

    link = false
    backgroundLayout = false

    if(style)
    {
        if(style.link)
        {
            link = style.link
            textViewLayout.color = linkColor
            textViewLayout.font = boldFont
            
            backgroundLayout = {
                type = "button"
                buttonType = "color"
                color = vec4(0.0,0.0,0.2,0.4)
                alignmentX = "left"
                alignmentY = "bottom"
                subviews = {
                    textViewLayout
                }
            }

            if(style.backgroundColor)
            {
                backgroundLayout.color = style.backgroundColor
            }
        }
        else if(style.backgroundColor)
        {
            backgroundLayout = {
                type = "color"
                color = style.backgroundColor
                alignmentX = "left"
                alignmentY = "bottom"
                subviews = {
                    textViewLayout
                }
            }
        }

        if(style.header)
        {
            textViewLayout.font = boldFont
            textViewLayout.fontSize = headerFontSize
        }

        if(style.bold)
        {
            textViewLayout.font = boldFont
        }
        else if(style.italic)
        {
            textViewLayout.font = italicFont
        }

        if(style.monospace)
        {
            textViewLayout.font = monoFont
        }

        if(style.font)
        {
            textViewLayout.font = style.font
        }

        if(style.fontSize)
        {
            textViewLayout.fontSize = style.fontSize
        }

        if(style.color)
        {
            textViewLayout.color = style.color
        }

    }

    if(!backgroundLayout)
    {
        backgroundLayout = {
            type = "view"
            alignmentX = "left"
            alignmentY = "bottom"
            subviews = {
                textViewLayout
            }
        }
    }

    if(style)
    {
        backgroundLayout.id = style.id
    }

    stateHash = string.format("%d%d%d%d", parser.monospace, parser.bold, parser.italic, parser.isHeader)
    accumulatedWidth = parser.cacheRowWidthAccumulator
    wrapWidth = markupView.parentSize.x - accumulatedWidth - markupView.padding.left - markupView.padding.right
    rowInfo = parser.currentRowInfo

    getCacheIfMatch = function(cacheItemIndex)
    {
       # print("in checkCacheMatches, rowInfo:", rowInfo)
        #print("parser.foundText:", parser.foundText)
        #print("in checkCacheMatches cacheItemIndex:", cacheItemIndex, "\nnumber of items in this row:", table.count(rowInfo.items), " parser.cacheRowIndex:", parser.cacheRowIndex)
        if(cacheItemIndex < table.count(rowInfo.items))
        {
            itemInfo = rowInfo.items[cacheItemIndex]
            #if(itemInfo.text != parser.foundText)
            #{
            #    print("itemInfo.text:",itemInfo.text," != parser.foundText:", parser.foundText)
            #    return nil
            #}

            if(stateHash != itemInfo.stateHash)
            {
                #print("stateHash:",stateHash," != itemInfo.stateHash:", itemInfo.stateHash)
                return nil
            }
            if(style)
            {
                itemStyle = itemInfo.style
                if(!itemStyle)
                {
                    #print("!itemStyle")
                    return nil
                }

                for(k,v in style)
                {
                    if(itemStyle[k] != v)
                    {
                        #print("itemStyle[",k,"] != ",v)
                        return nil
                    }
                }
            }
            else if(itemInfo.style)
            {
                #print("itemInfo.style")
                return nil
            }
            return itemInfo
        }
        return nil
    }

    foundCache = getCacheIfMatch(parser.cacheItemIndex)

    xPos = parser.cacheRowWidthAccumulator

    if(foundCache)
    {
        parser.cacheItemIndex++

        textView = foundCache.textView
        textView.captureStartCharacterIndex = captureStartCharacterIndex

        if((foundCache.text != parser.foundText) or (wrapWidth != foundCache.wrapWidth))
        {
            textView.wrapWidth = wrapWidth
            textView.text = parser.foundText

            foundCache.textWidth = textView.size.x
            foundCache.text = textView.text

            addedTextLength = string.length(textView.text)
            totalTextLength = string.length(parser.foundText)

            #print("addedTextLength:", addedTextLength, "/", totalTextLength)

            if(addedTextLength < totalTextLength)
            {
                if(addedTextLength == 0)
                {
                    parser.cacheItemIndex-- #bit of a hack, will clear this incomplete cached item when clearAnyRemainingCachedItemsFromCurrentRow is called
                }

                clearAnyRemainingCachedItemsFromCurrentRow(markupView)

                foundCache.backgroundView.pos = vec3(xPos, 0, 0)
                foundCache.backgroundView.size = textView.size

                rowView.size = vec2(xPos + textView.size.x, 
                            math.max(textView.size.y, rowView.size.y))

                if(markupView.currentEditingTextViewCaptureStartCharacterIndex)
                {
                    if(markupView.currentEditingTextViewCaptureStartCharacterIndex == textView.captureStartCharacterIndex)
                    {
                        markupView.currentEditingTextView = textView
                        markupView.cursorView.layoutParent = textView
                    }
                }

                addNextRowForWrapOverflow(markupView, style, addedTextLength)
                return
            }
            else
            {
                parser.cacheRowWidthAccumulator += foundCache.textWidth
            }
        }
        else
        {
            parser.cacheRowWidthAccumulator += foundCache.textWidth
        }


        foundCache.backgroundView.pos = vec3(xPos, 0, 0)
        foundCache.backgroundView.size = textView.size

        rowView.size = vec2(xPos + textView.size.x, 
                            math.max(textView.size.y, rowView.size.y))


        if(markupView.currentEditingTextViewCaptureStartCharacterIndex)
        {
            if(markupView.currentEditingTextViewCaptureStartCharacterIndex == textView.captureStartCharacterIndex)
            {
                markupView.currentEditingTextView = textView
                markupView.cursorView.layoutParent = textView
            }
        }

        #print("found cache:", parser.foundText, " cacheRowWidthAccumulator:", parser.cacheRowWidthAccumulator)
        
        return
    }
    
    #print("no cache found:", parser.foundText)

    if(parser.cacheItemIndex < table.count(rowInfo.items))
    {
        clearAnyRemainingCachedItemsFromCurrentRow(markupView)
        rowView.size = vec2(xPos, minLineHeight)
    }
    
    backgroundView = rowView.addView(backgroundLayout)

    rowInfo = parser.currentRowInfo

    textView = backgroundView.getView("textView")

    backgroundView.textView = textView #button.tui uses this too

    textView.wrapWidth = wrapWidth
    textView.wrapClamp = true
    textView.preventWordSeparation = (parser.cacheItemIndex != 0)
    textView.text = parser.foundText

    textView.captureStartCharacterIndex = captureStartCharacterIndex

    if(style and style.textEntry) #textEntry should be a function textEntry(textValue, changesMade)
    {
        textView.styleTextEntryFunction = style.textEntry
    }

    if(markupView.currentEditingTextViewCaptureStartCharacterIndex)
    {
        if(markupView.currentEditingTextViewCaptureStartCharacterIndex == textView.captureStartCharacterIndex)
        {
            markupView.currentEditingTextView = textView
            markupView.cursorView.layoutParent = textView
        }
    }

    backgroundView.click = function(mouseLoc)
    {
        if(link)
        {
            if(type(link) == "function")
            {
                link()
            }
            else
            {
                katipo.linkClicked(link)
            }
        }
        textBackgroundViewClickFunction(markupView, textView, mouseLoc)
    }

    backgroundView.clickOutside = function()
    {
        if(markupView.currentEditingTextView == textView)
        {
            finishEditing(markupView, false)
        }
    }

    #xPos = rowView.size.x
    backgroundView.pos = vec3(xPos, 0, 0)

    rowView.size = vec2(xPos + textView.size.x, 
                            math.max(textView.size.y, rowView.size.y))


    

    backgroundView.size = textView.size

    addedTextLength = string.length(textView.text)
    totalTextLength = string.length(parser.foundText)

    #print("addedTextLength:", addedTextLength, " totalTextLength:", totalTextLength)

    #################### add to cache

    cacheData = {
        xPos = xPos
        text = textView.text
        textView = textView
        textWidth = textView.size.x
        wrapWidth = wrapWidth
        backgroundView = backgroundView
        stateHash = stateHash
        #inputTextCharacterIndex = captureStartCharacterIndex
    }

    if(style)
    {
        cacheData.style = table.clone(style)
    }

    #print("parser.cacheItemIndex:", parser.cacheItemIndex, " rowInfo.items:", rowInfo.items)

    table.insert(rowInfo.items, cacheData)


    parser.cacheItemIndex = table.count(rowInfo.items)

    #print("added to cache:", cacheData.text)
    #print("parser.cacheItemIndex:", parser.cacheItemIndex)

    parser.cacheRowWidthAccumulator += cacheData.textWidth

    #print("addedTextLength:", addedTextLength, " totalTextLength:", totalTextLength)
    if(addedTextLength < totalTextLength)
    {
        addNextRowForWrapOverflow(markupView, style, addedTextLength)
    }
}

renderCapture = function(markupView, capture, parentStyle)
{
    parser = markupView.parser
    remainingText = parser.foundText
    style = {}
    if(parentStyle)
    {
        for(k,v in parentStyle)
        {
            style[k] = v
        }
    }
    loadedValue = load(capture.markupString, scene)
    #print("in renderCapture loadedValue:", loadedValue, " from string:", capture.markupString)

    valueType = type(loadedValue)
    if(valueType == "table") # [foo](id="bar", hidden=true)
    {
        for(k,v in loadedValue)
        {
            style[k] = v

            if(k == "id")
            {
                if(markupView.styles)
                {
                    idStyle = markupView.styles[v]
                    if(type(idStyle) == "table")
                    {
                        for(idK,idV in idStyle)
                        {
                            style[idK] = idV
                        }
                    }
                }
            }
        }
    }
    else if(valueType == "string") # [foo]("bar") treat "bar" as the id string
    {
        if(markupView.styles)
        {
            idStyle = markupView.styles[loadedValue]
            if(type(idStyle) == "table")
            {
                for(idK,idV in idStyle)
                {
                    style[idK] = idV
                }
            }
        }
    }

    for(item in capture.items)
    {
        if(item.text)
        {
            parser.foundText = item.text

            #this is a bit hacky, just need to pass through this capture's style somehow, but restore the parser state
            prevBold = parser.bold
            prevItalic = parser.italic
            prevMonospace = parser.monospace

            parser.bold = item.bold
            parser.italic = item.italic
            parser.monospace = item.monospace

            addItemView(markupView, style, item.startCharacterIndex)

            parser.bold = prevBold
            parser.italic = prevItalic
            parser.monospace = prevMonospace
        }
        else
        {
            renderCapture(markupView, item, style)
        }
    }
    parser.foundText = remainingText
}


finishCurrentText = function(markupView)
{
    parser = markupView.parser
    if(parser.currentCapture)
    {
        currentCapture = parser.currentCapture
        if(currentCapture.currentText)
        {
            item = {
                text = currentCapture.currentText
                startCharacterIndex = currentCapture.startCharacterIndex
                bold = parser.bold
                italic = parser.italic
                monospace = parser.monospace
            }
            table.insert(currentCapture.items, item)

            currentCapture.currentText = nil
        }
    }
    else
    {
        if(string.length(parser.foundText) > 0)
        {
            #print("adding:", parser.foundText)
            addItemView(markupView, nil)
            parser.foundText = ""
        }
    }
}

charFunc = function(markupView, charText, charIndex)
{ 
    parser = markupView.parser

    if(parser.captureClosedAwaitingParenthesis)
    {
        if(charText != "(")
        {
            print("error: expected '('")
            return true
        }
        parser.parenthesisStackCount = 1
        parser.foundMarkupCodeString = ""
        parser.captureClosedAwaitingParenthesis = false
    }
    else if(parser.parenthesisStackCount > 0)
    {
        if(charText == ")")
        {
            parser.parenthesisStackCount--
            if(parser.parenthesisStackCount == 0)
            {
                #print("found markup:", parser.foundMarkupCodeString)
                currentCapture = parser.currentCapture
                if(currentCapture)
                {
                    currentCapture.markupString = parser.foundMarkupCodeString
                    parentCapture = currentCapture.parentCapture
                    currentCapture.parentCapture = nil

                    if(currentCapture.currentText)
                    {
                        item = {
                            text = currentCapture.currentText
                            startCharacterIndex = currentCapture.startCharacterIndex
                        }
                        table.insert(currentCapture.items, item)
                        currentCapture.currentText = nil
                    }
                    if(!parentCapture)
                    {
                        renderCapture(markupView, currentCapture)
                    }
                    parser.currentCapture = parentCapture
                }
                else
                {
                    print("todo set line style")
                }
            }
        }
        else if(charText == "(")
        {
            parser.parenthesisStackCount++
        }

        if(parser.parenthesisStackCount != 0) 
        {
            parser.foundMarkupCodeString += charText
        }
    }
    else if(charText == "[")
    {
        prevCapture = parser.currentCapture
        newCapture = {
            parentCapture = prevCapture
            startCharacterIndex = parser.characterIndex
            items = {}
        }

        if(prevCapture)
        {
            if(prevCapture.currentText)
            {
                item = { #tui bug, adding this directly as a function call arg causes prevCapture to appear to be nil
                    text = prevCapture.currentText
                    startCharacterIndex = prevCapture.startCharacterIndex
                }
                table.insert(prevCapture.items, item)
                prevCapture.currentText = nil
            }

            table.insert(prevCapture.items, newCapture)
        }
        else
        {
            finishCurrentText(markupView)
        }

        parser.currentCapture = newCapture
    }
    else if(charText == "]")
    {
        finishCurrentText(markupView) hmm

        parser.captureClosedAwaitingParenthesis = true
    }
    else
    {
        if(charText == "*")
        {
            if(parser.italic or parser.bold)
            {
                if(parser.starCount > 0 or parser.italic)
                {
                    finishCurrentText(markupView)
                    parser.italic = nil
                    parser.bold = nil
                    parser.starCount = 0
                }
                else
                {
                    parser.starCount++
                }
            }
            else
            {
                parser.starCount++
            }
        }
        else if(charText == "`")
        {
            if(parser.monospace)
            {
                finishCurrentText(markupView)
                parser.monospace = nil
                parser.backtickCount = 0
            }
            else
            {
                parser.backtickCount++
            }
        }
        else if(parser.onlyFoundSpace)
        {
            if(charText == "(")
            {
                parser.parenthesisStackCount = 1
                parser.foundMarkupCodeString = ""
                parser.skipLeadingSpace = true
            }
            else if(charText == "#")
            {
                parser.isHeader = true
                parser.skipLeadingSpace = true
            }
            else
            {
                if(charText != " ")
                {
                    parser.onlyFoundSpace = false
                    parser.foundText += charText
                }
                else if(!parser.skipLeadingSpace)
                {
                    parser.foundText += charText
                }

            }
        }
        else #!onlyFoundSpace, !currentCapture, not ` or * or [] or inside ()
        {
            if(parser.starCount > 0)
            {
                finishCurrentText(markupView)

                if(parser.starCount > 1)
                {
                    parser.bold = true
                }
                else
                {
                    parser.italic = true
                }
                parser.starCount = 0
            }
            else if(parser.backtickCount > 0)
            {
                finishCurrentText(markupView)
                parser.monospace = true
                parser.backtickCount = 0
            }

            if(parser.currentCapture)
            {
                if(!parser.currentCapture.currentText)
                {
                    parser.currentCapture.currentText = charText
                }
                else
                {
                    parser.currentCapture.currentText += charText
                }
            }
            else
            {
                parser.foundText += charText
            }
        }
    }
}

lineFunc = function(markupView, lineText)
{
    parser = markupView.parser
    parser.isHeader = nil #anything that is closed by the line end needs to be set to nil here

    #if(parser.currentCapture)
    #{
    #    parser.currentLineCacheState.rowCount++
    #    parser.currentLineCacheState.text += "\n" + lineText
    #}
    #else
    #{
    #    #todo if we have a match, skip
    #    parser.currentLineCacheState = {
    #        #startRowIndex = parser.cacheRowIndex
    #        rowCount = 1
    #        items = {}
    #    }
    #}

    #if(parser.existingLineIndex and table.count(markupView.markupLines) > parser.existingLineIndex)
    #{
    #    parser.existingLineIndex++
    #}
    
    localCharFunc = function(charText, charIndex)
    {
        result = charFunc(markupView, charText, charIndex)
        parser.characterIndex++
        return result
    }

    string.eachChar(lineText, localCharFunc)

    parser.characterIndex++ #\n as we are in eachLine
    
    if(parser.currentCapture)
    {
        finishCurrentText(markupView)
        parser.currentCapture.currentText = "\n"
    }
    else
    {
        #todo if we have a match, skip

        addItemView(markupView, nil)
        parser.foundText = ""

        #print("add final:", parser.currentLineCacheState)
    }
    
    finishCurrentRow(markupView)

}

reloadText = function(markupView)
{
    markupText = markupView.currentMarkupText
    markupScrollView = markupView.scrollView

    parser = {
        onlyFoundSpace = true
        foundMarkupCodeString = ""
        foundText = ""
        parenthesisStackCount = 0
        starCount = 0
        backtickCount = 0
        cacheRowIndex = 0
        characterIndex = 0
    }

    markupView.parser = parser

    markupView.cursorView.layoutParent = markupView #bit of a hack, otherwise cursor may get removed when its parent text view is

    localLineFunc = function(line)
    {
        return lineFunc(markupView, line)
    }

    if(markupText)
    {
        string.eachLine(markupText, localLineFunc)
    }

    #print("table.count(markupView.cachedRows):", table.count(markupView.cachedRows), " parser.cacheRowIndex:", parser.cacheRowIndex)

    if(table.count(markupView.cachedRows) >= parser.cacheRowIndex)
    {
        markupScrollView.removeAllRows(parser.cacheRowIndex + 1)
        for(i = table.count(markupView.cachedRows) -1, i >= parser.cacheRowIndex, i--)
        {
            table.remove(markupView.cachedRows, i)
        }
    }

    if(markupScrollView.variableHeight)
    {
        markupScrollView.layoutRows()
        markupView.size = vec2(markupScrollView.size.x, math.max(markupScrollView.totalHeight, minLineHeight))
        #markupView.size = markupScrollView.size
    }
} 

create = function(parentView, viewLayout)
{
    layout = getViewLayout(viewLayout)
    markupView = parentView.addView(layout)

    markupView.cachedRows = {}

    scrollViewLayout = {
        size = viewLayout.size
    }
    scrollViewLayout.type = "scrollView"

    markupScrollView = markupView.addView(scrollViewLayout)
    markupView.scrollView = markupScrollView
    
    cursorViewLayout = {
        size = vec2(1,minLineHeight)
        type = "color"
        color = vec4(1.0,1.0,1.0,1.0)
        horizontalAlignment = "left"
        verticalAlignment = verticalAlignment
        pos = vec3(2,1,0)
    }
    
    cursorView = markupView.addView(cursorViewLayout)
    cursorView.hidden = true
    markupView.cursorView = cursorView

    markupView.padding = {
        top = topPaddingDefault
        bottom = topPaddingDefault
        left = leftPaddingDefault
        right = leftPaddingDefault
    }

    markupScrollView.markupPadding = markupView.padding
    
    if(viewLayout.markupPadding)
    {
        for(k,v in viewLayout.markupPadding)
        {
            markupScrollView.markupPadding[k] = v
        }
    }

    topPaddingLayout = {
        type = "view"
        size = vec2(markupView.padding.top,markupView.padding.top)
    }

    markupScrollView.addView(topPaddingLayout)

    markupView.setText = function(newText)
    {
        markupView.currentMarkupText = newText
        reloadText(markupView)
    }

    markupView.onParentSizeChanged = function(parentSize) #override the scrollView one with our own
    {
        markupScrollView.layoutRows()
        markupScrollView.parentSize = parentSize
        markupScrollView.size = parentSize

        markupView.size = parentSize
        markupView.parentSize = parentSize

        reloadText(markupView)
    }

    markupView.reload = function()
    {
        reloadText(markupView)
    }

    markupView.update = function(dt)
    {
        updateCursorFunction(markupView, dt)
    }

    return markupView
}