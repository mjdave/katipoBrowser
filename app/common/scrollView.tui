removeAllRows = function(scrollView, startIndexOrNil) # NOTE startIndexOrNil is untested, was't needed
{
    startIndex = startIndexOrNil
    if(!startIndex)
    {
        startIndex = 0
    }

    rowCount = table.count(scrollView.rowInfos)
    if(rowCount <= startIndex)
    {
        return
    }

    for(i=rowCount - 1, i >= startIndex, i--)
    {
        scrollView.baseView.removeView(scrollView.rowInfos[i].rowView)
        if(startIndexOrNil)
        {
            table.remove(scrollView.rowInfos, i)
        }
    }

    if(!startIndexOrNil)
    {
        scrollView.rowInfos = {}
    }

    scrollView.scrollYIndexMax = 0
    scrollView.dirty = true
}

