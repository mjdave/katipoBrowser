insertRow = function(scrollView, insertRowView, rowIndexOrNil)
{
    insertIndex = rowIndexOrNil
    if((!insertIndex) or insertIndex > table.count(scrollView.rowInfos))
    {
        insertIndex = table.count(scrollView.rowInfos)
    }

    addedRowHeight = insertRowView.size.y

    oldRowInfoAtThisPos = scrollView.rowInfos[insertIndex]
    aboveRowInfo = scrollView.rowInfos[insertIndex - 1]

    insertRowView.alignmentX = "left"
    #insertRowView.size.x = scrollView.size.x - backgroundWidth

    if(aboveRowInfo)
    {
        insertRowView.layoutParent = aboveRowInfo.rowView
        insertRowView.alignmentY = "below"
    }
    else
    {
        insertRowView.layoutParent = scrollView.baseItemView
        insertRowView.alignmentY = "top"
    }

    if(oldRowInfoAtThisPos)
    {
        oldRowInfoAtThisPos.rowView.layoutParent = insertRowView
    }

    
   # insertRowView.allowViewMovementUnderCursorToTriggerHoverStartEvents = true // todo maybe

    rowInfo = {
        rowView = insertRowView,
    }

    table.insert(scrollView.rowInfos, insertIndex, rowInfo)

    scrollView.contentHeight = scrollView.contentHeight + addedRowHeight

    updateYOffsets(scrollView, insertIndex)

    scrollView.dirty = true

}


removeAllRows = function(scrollView)
{
    for(i=table.count(scrollView.rowInfos) - 1, i >= 0, i--)
    {
        scrollView.removeView(scrollView.rowInfos[i].rowView)
    }
    scrollView.rowInfos = {}
    scrollView.contentHeight = 0.0

    scrollView.scrollYIndexMax = 0
    scrollView.dirty = true

}

removeRowAtIndex = function(scrollView, rowIndex)
{
    if(rowIndex and rowIndex > 0 and rowIndex <= table.count(scrollView.rowInfos))
    {
        scrollView.contentHeight = scrollView.contentHeight - scrollView.rowInfos[rowIndex].rowView.size.y
        viewToRemove = scrollView.rowInfos[rowIndex].rowView

        table.remove(scrollView.rowInfos, rowIndex)

        newCurrentPositionRowInfo = scrollView.rowInfos[rowIndex]
        if(newCurrentPositionRowInfo)
        {
            aboveRowInfo = scrollView.rowInfos[rowIndex - 1]

            if(aboveRowInfo)
            {
                newCurrentPositionRowInfo.rowView.layoutParent = aboveRowInfo.rowView
                newCurrentPositionRowInfo.rowView.relativePosition = ViewPosition(scrollView.contentHorizontalAlignment, MJPositionBelow)
            }
            else
            {
                newCurrentPositionRowInfo.rowView.layoutParent = scrollView.baseItemView
                newCurrentPositionRowInfo.rowView.relativePosition = ViewPosition(scrollView.contentHorizontalAlignment, MJPositionTop)
            }
        }

        scrollView.removeView(viewToRemove)
        updateYOffsets(scrollView, rowIndex)
        scrollView.dirty = true
    }
}

removeRow = function(scrollView, rowView)
{
    for(rowIndex,rowInfo in scrollView.rowInfos) 
    {
        if(rowInfo.rowView == rowView)
        {
            removeRowAtIndex(scrollView, rowIndex)
            return
        }
    }

}
