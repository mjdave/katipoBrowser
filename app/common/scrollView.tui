removeRow = function(scrollView, rowView)
{
    error("todo")
    for(rowIndex,rowInfo in scrollView.rowInfos) 
    {
        if(rowInfo.rowView == rowView)
        {
            removeRowAtIndex(scrollView, rowIndex)
            return
        }
    }

}
