
knobSize = vec2(20.0, 30.0)
backgroundWidth = 20.0
knobZOffset = 0


updateYOffsets = function(scrollView, rowStartIndex)
{
    for(i=rowStartIndex, i < table.count(scrollView.rowInfos), i++)
    {
        rowInfo = scrollView.rowInfos[i]
        aboveRowInfo = scrollView.rowInfos[i - 1]
        if(aboveRowInfo)
        {
            rowInfo.yOffsetFromTop = aboveRowInfo.yOffsetFromTop + aboveRowInfo.rowView.size.y
        }
        else
        {
            rowInfo.yOffsetFromTop = 0
        }
    }
}

updatePositionsAndVisibilities = function(scrollView)
{
    for(i=0, i < table.count(scrollView.rowInfos), i++)
    {
        rowInfo = scrollView.rowInfos[i]
        if(rowInfo.yOffsetFromTop + rowInfo.rowView.size.y + scrollView.scrollYOffset <= 0)
        {
            rowInfo.rowView.hidden = true
        }
        else
        {
            if(rowInfo.yOffsetFromTop + scrollView.scrollYOffset >= scrollView.parentSize.y)
            {
                rowInfo.rowView.hidden = true
            }
            else
            {
                rowInfo.rowView.hidden = false
            }
        }
    }
    
    knobView = scrollView.knobView
    size = scrollView.parentSize

    fraction = -scrollView.scrollYOffset / scrollView.scrollYHeight
    knobY = size.y * fraction
    knobView.pos = vec3(2, size.y - (knobY - fraction * knobSize.y) - knobSize.y, knobZOffset)
}

recreateDerivedData = function(scrollView)
{
    scrollView.scrollYIndexMax = 0
    for(i=0, i < table.count(scrollView.rowInfos), i++)
    {
        rowInfo = scrollView.rowInfos[i]
        if(rowInfo.yOffsetFromTop + rowInfo.rowView.size.y > scrollView.parentSize.size.y + 0.5)
        {
            scrollView.scrollYIndexMax = scrollView.scrollYIndexMax + 1
        }
    }
    scrollView.scrollYHeight = 0
    for(i=0, i < scrollView.scrollYIndexMax, i++)
    {
        rowInfo = scrollView.rowInfos[i]
        scrollView.scrollYHeight = scrollView.scrollYHeight + rowInfo.rowView.size.y
    }

    scrollerBackgroundView = scrollView.scrollerBackgroundView
    knobView = scrollView.knobView
    
    if(scrollView.scrollYIndexMax == 0)
    {
        knobView.hidden = true
    }
    else
    {
        knobView.hidden = false
    }
    updatePositionsAndVisibilities(scrollView)
    scrollView.dirty = false
}

getViewLayout = function(viewLayout)
{
    scrollViewLayout = {}
    for(k,v in viewLayout)
    {
        scrollViewLayout[k] = v
    }

    scrollViewLayout.type = "view"
    
    return scrollViewLayout
}

create = function(parentView, viewLayout)
{
    scrollView = parentView.addView(getViewLayout(viewLayout))
    scrollView.setClipChildren(true)

    scrollView.rowInfos = {}
    scrollView.contentHeight = 0.0
    scrollView.scrollYIndexMax = 0
    scrollView.scrollYOffset = 0.0
    scrollView.scrollVelocity = 0

    scrollView.backgroundHover = false
    scrollView.knobHover = false

    scrollView.size = function(parentSize)
    {
        scrollView.parentSize = parentSize
        scrollView.dirty = true
        return parentSize
    }

    baseItemLayout = {
        size = vec2(0,0)
        alignmentX = "left"
        alignmentY = "top"
        type = "view"
    }
    
    baseItemView = scrollView.addView(baseItemLayout)
    scrollView.baseItemView = baseItemView

    scrollerBackgroundLayout = {
        id = "scrollerBackground"
        size = function(parentSize)
        {
            return vec2(backgroundWidth, parentSize.y)
        }
        alignmentX = "right"
        alignmentY = "top"
        type = "color"
        color = vec4(0.2,0.3,0.5,0.1)
    }

    scrollerBackgroundView = scrollView.addView(scrollerBackgroundLayout)
    scrollView.scrollerBackgroundView = scrollerBackgroundView


    knobLayout = {
        size = knobSize
        alignmentY = "bottom"
        type = "color"
        color = vec4(1.0,1.0,1.0,0.2)
        layoutParentID = "scrollerBackground"
        pos = vec3(2, 0, knobZOffset)
    }

    knobView = scrollView.addView(knobLayout)
    scrollView.knobView = knobView

    mainViewMouseDown = function(buttonIndex, mouseLoc)
    {
        if(!scrollView.disabled and scrollView.scrollYIndexMax != 0)
        {
            scrollView.lastY = mouseLoc.y
            scrollView.startY = mouseLoc.y
        }
    }
    
    mainViewMouseDragged = function(buttonIndex, mouseLoc)
    {
        if(!scrollView.disabled and scrollView.scrollYIndexMax != 0 and !scrollView.isScrollBarMouseDown)
        {
            diff = scrollView.lastY - mouseLoc.y
            if(diff > 1 or diff < -1)
            {
                startDiff = mouseLoc.y - scrollView.startY
                if(startDiff > 4.0 or startDiff < -4.0)
                {
                    scrollView.scrollInProgress = true
                    minScroll = -scrollView.scrollYHeight
                    maxScroll = 0
                    
                    if(scrollView.scrollYOffset + diff < minScroll or scrollView.scrollYOffset + diff > maxScroll)
                    {
                        diff *= 0.5
                    }
                    
                    scrollView.scrollVelocity = diff * 2.0
                    scrollView.scrollYOffset += diff
                    scrollView.lastY = mouseLoc.y
                }
            }
        }
    }

    mainViewMouseUp = function(buttonIndex, mouseLoc)
    {
        scrollView.isScrollBarMouseDown = false
        scrollView.scrollInProgress = false
    }

    scrollerMouseDown = function(buttonIndex, mouseLoc)
    {
        if(!scrollView.disabled and scrollView.scrollYIndexMax != 0)
        {
            scrollView.isScrollBarMouseDown = true

            desiredY = -(1.0 - (mouseLoc.y / scrollView.parentSize.y)) * scrollView.scrollYHeight
            offset = desiredY - scrollView.scrollYOffset
            scrollView.scrollVelocity = offset * 0.3
        }
    }
    
    scrollerMouseDragged = function(buttonIndex, mouseLoc)
    {
        if(!scrollView.disabled and scrollView.scrollYIndexMax != 0)
        {
            scrollView.scrollBarScrollInProgress = true

            desiredY = -(1.0 - (mouseLoc.y / scrollView.parentSize.y)) * scrollView.scrollYHeight
            offset = desiredY - scrollView.scrollYOffset
            scrollView.scrollVelocity = offset * 0.3
        }
    }

    scrollerMouseUp = function(buttonIndex, mouseLoc)
    {
        scrollView.isScrollBarMouseDown = false

        if(!scrollView.disabled and scrollView.scrollYIndexMax != 0)
        {
            scrollView.scrollBarScrollInProgress = false
        }
    }


    scrollerBackgroundView.mouseDown = scrollerMouseDown
    scrollerBackgroundView.mouseDragged = scrollerMouseDragged
    scrollerBackgroundView.mouseUp = scrollerMouseUp

    scrollView.mouseDown = mainViewMouseDown
    scrollView.mouseDragged = mainViewMouseDragged
    scrollView.mouseUp = mainViewMouseUp
    
    knobView.mouseDown = function(buttonIndex, mouseLoc)
    {
        backgroundLoc = knobView.locationRelativeToView(mouseLoc, scrollerBackgroundView)
        scrollerMouseDown(buttonIndex, backgroundLoc)
    }

    knobView.mouseDragged = function(buttonIndex, mouseLoc) 
    {
        backgroundLoc = knobView.locationRelativeToView(mouseLoc, scrollerBackgroundView)
        scrollerMouseDragged(buttonIndex, backgroundLoc)
    }

    scrollView.mouseWheel = function(position, scrollChange)
    {
        offset = scrollChange.y
        if(scrollChange.y >= 1)
        {
            offset = math.floor(scrollChange.y)
        }
        elseif(scrollChange.y <= -1)
        {
            offset = math.ceil(scrollChange.y)
        }

        scrollView.scrollVelocity += offset * 2.0
    }

    hoverStart = function()
    {
        if(!scrollView.hover)
        {
            if(scrollView.backgroundHover or scrollView.knobHover)
            {
                if(!scrollView.disabled and scrollView.scrollYIndexMax != 0)
                {
                    scrollView.hover = true
                    #audio:playUISound(uiCommon.hoverSoundFile)
                    #knobView:setModel(model:modelIndexForName("ui_slider_knob"), {
                    #    [material.types.ui_standard.index] = material.types.ui_selected.index
                    #})
                    #scrollerBackgroundView:setModel(model:modelIndexForName("ui_slider_vertical_bg"), {
                    #    [material.types.ui_standard.index] = material.types.ui_selected.index
                    #})
                }
            }
        }
    }

    hoverEnd = function()
    {
        if(scrollView.hover)
        {
            if((!scrollView.backgroundHover) and (!scrollView.knobHover))
            {
                scrollView.hover = false
                scrollView.mouseDown = false
                #knobView:setModel(model:modelIndexForName("ui_slider_knob"))
                #scrollerBackgroundView:setModel(model:modelIndexForName("ui_slider_vertical_bg"))
            }
        }
    }
    
    scrollerBackgroundView.hoverStart = function()
    {
        scrollView.backgroundHover = true
        hoverStart()
    }

    scrollerBackgroundView.hoverEnd = function()
    {
        scrollView.backgroundHover = false
        hoverEnd()
    }
    
    
    knobView.hoverStart = function()
    {
        scrollView.knobHover = true
        hoverStart()
    }

    knobView.hoverEnd = function()
    {
        scrollView.knobHover = false
        hoverEnd()
    }


    scrollView.insertRow = function(insertRowView, rowIndexOrNil)
    {
        insertRow(scrollView, insertRowView, rowIndexOrNil)
    }

    scrollView.removeAllRows = function()
    {
        removeAllRows(scrollView)
    }

    scrollView.removeRowAtIndex = function(rowIndex)
    {
        removeRowAtIndex(scrollView, rowIndex)
    }

    scrollView.removeRowAtIndex = function(rowView)
    {
        removeRow(scrollView, rowView)
    }

    
    scrollView.update = function(dt)
    {
        if(scrollView.dirty)
        {
            recreateDerivedData(scrollView)
        }

        if(!scrollView.scrollInProgress)
        {
            scrollView.scrollYOffset += scrollView.scrollVelocity

            scrollView.scrollVelocity = scrollView.scrollVelocity * (1.0 - math.min(dt * 16, 1))
            
            minScroll = -scrollView.scrollYHeight
            maxScroll = 0
            
            if(scrollView.scrollYOffset < minScroll)
            {
                scrollView.scrollYOffset -= (scrollView.scrollYOffset - minScroll) * math.min(dt * 16, 1)
            }
            else if(scrollView.scrollYOffset > maxScroll)
            {
                scrollView.scrollYOffset -= (scrollView.scrollYOffset - maxScroll) * math.min(dt * 16, 1)
            }
        }

        scrollView.baseItemView.pos = vec3(0, - scrollView.scrollYOffset,0)
        updatePositionsAndVisibilities(scrollView)
    }

    removeAllRows(scrollView)
    
    return scrollView
}


scrollerIsVisible = function(scrollView)
{
    return (scrollView.scrollView.scrollYIndexMax != 0)
}

