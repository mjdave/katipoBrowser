initHue = function(view, buttonViewLayout)
{
    view.hueOffset = buttonViewLayout.hueOffset
    if(!view.hueOffset)
    {
        view.hueOffset = 0.0
    }

    view.setHueOffset = function(hueOffset)
    {
        view.hueOffset = hueOffset
        updateHueVisuals(view)
    }

    if(buttonViewLayout.clip)
    {
        if(buttonViewLayout.buttonType == "imageHueShift")
        {
            view.shader = "drawQuadTexturedHueShiftClip"
        }
        else
        {
            view.shader = "colorViewHueShiftClip"
        }
    }
}

updateHueVisuals = function(view)
{
    if(view.mouseIsDown)
    {
        view.shaderUserData = vec4(view.hueOffset + math.pi,0,0,0)
    }
    else if(view.isHover)
    {
        view.shaderUserData = vec4(view.hueOffset + 0.5 * math.pi,0,0,0)
    }
    else
    {
        view.shaderUserData = vec4(view.hueOffset,0,0,0)
    }
}

updateDerivedColors = function(view, baseColor, highlightColorOrNil, mouseDownColorOrNil, selectedColorOrNil)
{
    view.baseColor = baseColor
    if(!view.baseColor)
    {
        view.baseColor = vec4(0.0,0.0,0.0,0.0)
    }

    if(highlightColorOrNil)
    {
        view.highlightColor = highlightColorOrNil
    }

    if(!view.highlightColor)
    {
        view.highlightColor = view.baseColor + vec4(0.0,0.02,0.01,0.0)
    }

    if(mouseDownColorOrNil)
    {
        view.mouseDownColor = mouseDownColorOrNil
    }
    if(!view.mouseDownColor)
    {
        view.mouseDownColor = view.baseColor + vec4(0.0,0.05,0.02,0.0)
    }
    if(selectedColorOrNil)
    {
        view.selectedColor = selectedColorOrNil
    }
    if(!view.selectedColor)
    {
        view.selectedColor = view.baseColor + vec4(0.2,0.0,0.5,0.0)
        view.selectedColor.w = 0.1
    }

    view.color = view.baseColor
    view.currentDesiredColor = view.color
}

initColor = function(view, buttonViewLayout)
{
    updateDerivedColors(view, buttonViewLayout.color, buttonViewLayout.highlightColor, buttonViewLayout.mouseDownColor, buttonViewLayout.selectedColor)

    if(buttonViewLayout.clip)
    {
        if(buttonViewLayout.buttonType == "image")
        {
            view.shader = "drawQuadTexturedClip"
        }
        else
        {
            view.shader = "colorViewClip"
        }
    }

}

updateColorVisuals = function(view)
{
    if(view.mouseIsDown)
    {
        view.color = view.mouseDownColor
    }
    else if(view.selected)
    {
        view.color = view.selectedColor
    }
    else
    {
        view.color = view.baseColor
    }
    
    if(view.isHover)
    {
        view.color = view.color + view.highlightColor
    }

    view.currentDesiredColor = view.color

    if(view.disabled)
    {
        view.alpha = 0.3
    }
    else
    {
        view.alpha = 1.0
    }
}

buttonTypes = {
    color = {
        viewLayout = {
            type = "color"
        }
        initFunc = initColor
        updateFunc = updateColorVisuals
    }

    colorHueShift = {
        viewLayout = {
            type = "color"
            shader = "colorViewHueShift"
        }
        initFunc = initHue
        updateFunc = updateHueVisuals
    }


    image = {
        viewLayout = {
            type = "image"
            shader = "drawQuadTextured"
        }
        initFunc = initColor
        updateFunc = updateColorVisuals
    }

    imageHueShift = {
        viewLayout = {
            type = "image"
            shader = "drawQuadTexturedHueShift"
        }
        initFunc = initHue
        updateFunc = updateHueVisuals
    }
}

getViewLayout = function(viewLayout, buttonType)
{
    buttonViewLayout = {}
    for(k,v in viewLayout)
    {
        buttonViewLayout[k] = v
    }

    for(k,v in buttonType.viewLayout)
    {
        buttonViewLayout[k] = v
    }
    return buttonViewLayout
}

updateVisuals = function(view)
{
    if(view.buttonType.updateFunc)
    {
        view.buttonType.updateFunc(view)
    }

}

createAnimationUpdateFunc = function(view)
{
    if(!view.update)
    {
        view.update = function(dt)
        {
            if(view.clickFraction != nil)
            {
                view.clickFraction -= dt * 4.0
                if(view.clickFraction > 0.0)
                {
                    view.color = math.mix(view.currentDesiredColor, view.mouseDownColor, view.clickFraction)
                }
                else
                {
                    view.color = view.currentDesiredColor
                    view.clickFraction = nil
                }
            }
            else
            {
                view.update = nil
            }
        }
    }
}

create = function(parentView, viewLayout)
{
    buttonTypeKey = viewLayout.buttonType
    if(!buttonTypeKey or !buttonTypes[buttonTypeKey])
    {
        error("attempt to create button with missing or invalid buttonType:", buttonTypeKey)
    }
    buttonType = buttonTypes[buttonTypeKey]
    viewLayoutFinal = getViewLayout(viewLayout, buttonType)
    view = parentView.addView(viewLayoutFinal)
    view.buttonType = buttonType
    view.selected = viewLayout.selected

    view.setSelected = function(newSelected)
    {
        if(newSelected != view.selected)
        {
            view.selected = newSelected
            updateVisuals(view)
        }
    }

    view.updateVisuals = function()
    {
        updateVisuals(view)
    }


    if(buttonType.initFunc)
    {
        buttonType.initFunc(view, viewLayout)
    }

    view.hoverStart = function()
    {
        if(!view.disabled and view.click)
        {
            view.isHover = true
            updateVisuals(view)
        }
    }

    view.hoverEnd = function()
    {
        view.isHover = false
        updateVisuals(view)
    }

    view.mouseDown = function()
    {
        if(!view.disabled and view.click)
        {
            view.mouseIsDown = true
            updateVisuals(view)
        }
    }

    view.mouseUp = function()
    {
        view.mouseIsDown = false
        updateVisuals(view)
    }

    view.setColor = function(newColor)
    {
        view.color = newColor
        updateDerivedColors(view, newColor)
    }

    view.setDisabled = function(newDisabled)
    {
        view.disabled = newDisabled
        updateVisuals(view)
    }

    view.setClickFunction = function(clickFunc)
    {
        if(clickFunc)
        {
            view.click = function()
            {
                view.clickFraction = 1.0
                createAnimationUpdateFunc(view)
                clickFunc()
            }
        }
        else
        {
            view.click = nil
        }
    }

    updateVisuals(view)

    return view
}
