# NOTE this is used in two places, both when there is a simple result, like an error with a message, and when displaying a basic tui markup document .tml site
viewTypes = { #can be added to at any time
    markup = require("app/common/markupView.tui")
    scrollView = require("app/common/scrollView.tui") #required by markupView
}

mainView = {
    type = "view"
    subviews = {
        {
            id = "pageTitle"
            type = "text"
            font = "roboto"
            fontSize = 24
            alignmentY = "above"
            layoutParentID = "pageBody"
        }
        {
            id = "pageBody"
            type = "markup"
            font = "roboto"
            fontSize = 18
        }
    }
}