
hostedSiteScene = require("app/katipoBrowser/scripts/hostedSiteManagementScene.tui")

mainView = false

saveHostedBookmarksFunc = false

init = function(siteContentBackground, saveHostedBookmarksFunc_)
{
    .mainView = siteContentBackground.addView(hostedSiteScene.mainView)
    .saveHostedBookmarksFunc = saveHostedBookmarksFunc_
}


updateStartStopButton = function(bookmark)
{

}

show = function(bookmark, sitePath)
{
    title = bookmark.siteInfo.title
    description = bookmark.siteInfo.description

    pageText = "#" + title + "\n"
    pageText += description + "\n"

    pageBody = mainView.getView("pageBody")
    pageBody.setText(pageText)

    startStopButton = mainView.getView("startStopButton")
    startStopButtonText = startStopButton.getView("startStopButtonText")

    updateStartStopButton = function(running)
    {
        if(running) #todo start running bookmarks when app launches
        {
            startStopButtonText.text = hostedSiteScene.stopText
            startStopButton.setColor(hostedSiteScene.stopColor)
        }
        else
        {
            startStopButtonText.text = hostedSiteScene.startText
            startStopButton.setColor(hostedSiteScene.startColor)
        }
    }

    updateStartStopButton(bookmark.running)


    updateButton = mainView.getView("updateButton")
    updateButton.setDisabled(true)
    #updateButton.click = function()
    #{
    #}


    startStopButton.click = function()
    {
        bookmark.running = katipo.setHostRunning(bookmark.hostID, !bookmark.running) #returns the running state

        saveHostedBookmarksFunc()
        updateStartStopButton(bookmark.running)
    }

    openDirectoryButton = mainView.getView("openDirectoryButton")
    openDirectoryButton.click = function()
    {
        print("opening:", sitePath)
        katipo.openURL("file://" + sitePath)
    }

    mainView.hidden = false
}

hide = function()
{
    mainView.hidden = true
}