viewTypes = { #can be added to at any time
    button = require("app/common/button.tui")
    textEntry = require("app/common/textEntry.tui")
    scrollView = require("app/common/scrollView.tui")
    markup = require("app/common/markupView.tui")
}

urlTextEntryHeight = 30

bookmarksListWidth = 500
bookMarkHeight = 40

mainButtonWidth = 160

mainView = {
    id = "mainView"
    type = "image"
    path = "app/katipoBrowser/images/colorsBackground.png"
    shader = "drawQuadTexturedHueShift"
    subviews = {
        {
            id = "windowSafeBackground"
            type = "view"
            alignmentX = "left"
            alignmentY = "top"
            subviews = {
                {
                    id = "siteContent"
                    type = "color"
                    color = vec4(0.1,0.2,0.0,0.2)
                }
                {
                    id = "browserManagementView"
                    type = "view"
                    hidden = true
                    subviews = {
                        {
                            id = "bookmarksScrollView"
                            type = "scrollView"
                            alignmentY = "above"
                            layoutParentID = "urlTextEntry"
                        }
                        {
                            id = "hostedSitesScrollView"
                            type = "scrollView"
                            alignmentY = "above"
                            layoutParentID = "urlTextEntry"
                            hidden = true
                        }
                        {
                            id = "refreshButton"
                            type = "button"
                            buttonType = "image"
                            color = vec4(1.0,1.0,1.0,1.0)
                            path = "app/katipoBrowser/images/refresh.png"
                            size = vec2(urlTextEntryHeight,urlTextEntryHeight)
                            alignmentX = "outerRight"
                            layoutParentID = "urlTextEntry"
                            pos = vec3(10,0,0)
                        }
                        {
                            id = "browseButton"
                            type = "button"
                            alignmentY = "top"
                            buttonType = "color"
                            color = vec4(0.2,0.0,0.2,0.1)
                            selectedColor = vec4(0.4,0.0,0.4,0.7)
                            selected = true
                            pos = vec3(-mainButtonWidth / 2 - 5,-10,0)
                            size = vec2(mainButtonWidth, 30)
                            subviews = {
                                {
                                    id = "browseButtonText"
                                    type = "text"
                                    text = "Browse"
                                    font = "robotoBold"
                                    fontSize = 20
                                    color = vec4(1.0,1.0,1.0,1.0)
                                }
                            }
                        }
                        {
                            id = "hostButton"
                            type = "button"
                            alignmentY = "top"
                            buttonType = "color"
                            color = vec4(0.2,0.2,0.0,0.1)
                            selectedColor = vec4(0.4,0.4,0.0,0.7)
                            pos = vec3(mainButtonWidth / 2 + 5,-10,0)
                            size = vec2(mainButtonWidth, 30)
                            subviews = {
                                {
                                    id = "hostButtonText"
                                    type = "text"
                                    text = "Host"
                                    font = "robotoBold"
                                    fontSize = 20
                                    color = vec4(1.0,1.0,1.0,1.0)
                                }
                            }
                        }
                    }
                }
                {
                    id = "urlTextEntry"
                    type = "textEntry"
                    fontSize = 16
                    onParentSizeChanged = function(parentSize)
                    {
                        return vec2(parentSize.x, urlTextEntryHeight)
                    }
                    alignmentY = "bottom"
                    pos = vec3(5,5,0)
                    backgroundColor = vec4(0.0,0.0,0.05,1.0)
                }
            }
        }
    }
}

bookmarkIconPadding = 4

bookmark = {
    id = "bookmark"
    type = "view"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x - 15.0, bookMarkHeight)
    }

    subviews = {
        {
            id = "bookmarkButton"
            type = "button"
            buttonType = "color"
            #color = vec4(0.0,0.0,0.0,0.0)
            #highlightColor = vec4(0.0,0.0,0.0,0.0)
            subviews = {
                {
                    id = "bookmarkMissingImage"
                    type = "color"
                    color = vec4(1.0,0.0,0.0,1.0) #should be set elsewhere
                    alignmentX = "left"
                    size = vec2(bookMarkHeight - bookmarkIconPadding,bookMarkHeight - bookmarkIconPadding)
                    pos = vec3(bookmarkIconPadding,0,0)

                    subviews = {
                        {
                            id = "bookmarkMissingImageCharacter"
                            type = "text"
                            text = "?"
                            font = "roboto"
                            fontSize = 32
                        }
                    }
                }
                {
                    id = "bookmarkImage"
                    type = "image"
                    alignmentX = "left"
                    size = vec2(bookMarkHeight - bookmarkIconPadding,bookMarkHeight - bookmarkIconPadding)
                    pos = vec3(bookmarkIconPadding,0,0)
                    hidden = true
                }
                {
                    id = "bookmarkTitle"
                    type = "text"
                    text = "Site Title"
                    font = "roboto"
                    fontSize = 18
                    alignmentX = "outerRight"
                    layoutParentID = "bookmarkImage"
                    alignmentY = "top"
                    pos = vec3(bookmarkIconPadding * 2,0,0)
                }
                {
                    id = "bookmarkSubtitle"
                    type = "text"
                    text = "Site Subtitle"
                    font = "roboto"
                    fontSize = 12
                    alignmentX = "left"
                    alignmentY = "below"
                    layoutParentID = "bookmarkTitle"
                }
            }
        }
    }
}