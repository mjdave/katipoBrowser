urlTextEntryHeight = 40

bookmarksListWidth = 500
bookMarkHeight = 40

mainView = {
    type = "image"
    path = "app/katipoBrowser/img/colorsBackground.png"
    shader = "drawQuadTexturedHueShift"
    subviews = {
        {
            id = "windowSafeBackground"
            type = "view"
            alignmentX = "left"
            alignmentY = "top"
            subviews = {
                {
                    id = "siteContent"
                    type = "color"
                    color = vec4(0.1,0.2,0.0,0.2)
                    alignmentY = "top"
                }
                {
                    id = "bookmarks"
                    type = "view"
                    alignmentY = "above"
                    layoutParentID = "urlTextEntry"
                    size = function(parentSize)
                    {
                        return vec2(math.min(bookmarksListWidth, parentSize.x), parentSize.y - urlTextEntryHeight)
                    }
                }
                {
                    id = "urlTextEntry"
                    type = "image"
                    path = "app/katipoBrowser/img/colorsBackground.png"
                    shader = "drawQuadTexturedHueShift"
                    size = function(parentSize)
                    {
                        return vec2(parentSize.x, urlTextEntryHeight)
                    }
                    alignmentY = "bottom"
                }
            }
        }
    }
}

bookmarkIconPadding = 4

bookmark = {
    type = "color"
    color = vec4(0.0,0.05,0.1,0.3)
    size = function(parentSize)
    {
        return vec2(parentSize.x, bookMarkHeight)
    }

    subviews = {
        {
            id = "bookmarkMissingImage"
            type = "color"
            color = vec4(0.0,0.6,0.8,0.8) #todo set this randomly for each site, maybe get from siteInfo
            alignmentX = "left"
            size = vec2(bookMarkHeight - bookmarkIconPadding,bookMarkHeight - bookmarkIconPadding)
            pos = vec3(bookmarkIconPadding,0,0)

            subviews = {
                {
                    id = "bookmarkMissingImageCharacter"
                    type = "text"
                    text = "?"
                    font = "roboto"
                    fontSize = 32
                }
            }
        }
        {
            id = "bookmarkImage"
            type = "image"
            alignmentX = "left"
            size = vec2(bookMarkHeight - bookmarkIconPadding,bookMarkHeight - bookmarkIconPadding)
            pos = vec3(bookmarkIconPadding,0,0)
            hidden = true
        }
        {
            id = "bookmarkTitle"
            type = "text"
            text = "Site Title"
            font = "roboto"
            fontSize = 16
            alignmentX = "outerRight"
            layoutParentID = "bookmarkImage"
            alignmentY = "top"
            pos = vec3(bookmarkIconPadding * 2,0,0)
        }
        {
            id = "bookmarkSubtitle"
            type = "text"
            text = "Site Subtitle"
            font = "roboto"
            fontSize = 14
            alignmentX = "left"
            alignmentY = "below"
            layoutParentID = "bookmarkTitle"
        }
    }
}