
keys = require("app/common/keys.tui")

defaultSiteScene = require("app/katipoBrowser/scripts/defaultSiteScene.tui")
hostedSiteManagement = false

currentSiteHostID = false
currentURLFullLink = ""
currentURLSiteName = false
getInProgress = false
hostTabSelected = false # very simple tab setup for now, we either have 'browse' or 'host' selected, this is that state

bookmarks = database.get("bookmarks")
if(!bookmarks)
{
    bookmarks = {}
}

hostedSiteBookmarks = database.get("hostedSiteBookmarks")
if(!hostedSiteBookmarks)
{
    hostedSiteBookmarks = {}
}
else
{
    for(i, hostedSiteBookmark in hostedSiteBookmarks)
    {
        hostedSiteBookmark.running = false
        #todo if(hostedSiteBookmark.running and hostedSiteBookmark.autoStart) then start
    }
}

saveHostedBookmarks = function()
{
    database.set("hostedSiteBookmarks", hostedSiteBookmarks)
}

urlTextEntry = scene.getView("urlTextEntry")
refreshButton = scene.getView("refreshButton")

browseButton = scene.getView("browseButton")
hostButton = scene.getView("hostButton")

windowSafeBackground = scene.getView("windowSafeBackground")
windowSafeBackground.onParentSizeChanged = function(parentSize)
{
    windowSafeArea = eventManager.getWindowSafeArea()
    windowSafeBackground.pos = vec3(windowSafeArea.x, -windowSafeArea.y, 0)
    return vec2(windowSafeArea.z, windowSafeArea.w)
}

siteContentBackground = scene.getView("siteContent")
siteContentBackground.update = function(dt)
{
    if(siteContentBackground.goalColor and siteContentBackground.goalColor != siteContentBackground.color)
    {
        siteContentBackground.color = math.mix(siteContentBackground.color, siteContentBackground.goalColor, dt * 4.0)
    }
}

defaultSiteContent = siteContentBackground.addView(defaultSiteScene.mainView)
defaultSiteContent.hidden = true

installHostContent = false #only load this if required

pageBody = defaultSiteContent.getView("pageBody")

bookmarkLayout = scene.bookmark
bookmarksScrollView = scene.getView("bookmarksScrollView")
browserManagementView = scene.getView("browserManagementView")

untrustedSiteCodePermissionFunction = function(functionName, args, hasPermissionCallback)
{
    print("Warning: host is attempting to use protected tui function:\"", functionName, "\" with args:", args, "\nTODO: Katipo needs to check client settings or ask if this is OK, but for now it is not OK")
    hasPermissionCallback(false)
}


setHostTabSelected = function(newHostTabSelected)
{
    .hostTabSelected = newHostTabSelected
    browseButton.setSelected(!newHostTabSelected)
    hostButton.setSelected(newHostTabSelected)

    if(!newHostTabSelected)
    {
        hideSiteManagement()
    }
}

browseButton.click = function()
{
    setHostTabSelected(false)
    loadBookmarks()
}

hostButton.click = function()
{
    setHostTabSelected(true)
    loadBookmarks()
}

getClientSitePath = function(hostID)
{
    return file.getSavePath("clientSites/" + hostID + "/")
}

getHostSitePublicPath = function(hostID)
{
    return file.getSavePath("hostedSites/" + hostID + "/public/")
}

getHostSitePrivatePath = function(hostID)
{
    return file.getSavePath("hostedSites/" + hostID + "/private/")
}

findBookmark = function(url)
{
    for(i, existing in bookmarks)
    {
        if(existing.url == url)
        {
            return existing
        }
    }
    return nil
}


fadeSiteContent = function(fadeIn)
{
    if(fadeIn)
    {
        siteContentBackground.fadeIn()
    }
    else
    {
        siteContentBackground.fadeOut()
    }
    katipo.setPauseSiteContentForModalOverlay(!fadeIn)
}



writeFile = function(siteSavePath, checksums, fileInfo)
{
    #print("fileInfo:", fileInfo)
    filePath = siteSavePath + fileInfo.fileName
    checksums[fileInfo.fileName] = fileInfo.checksum
    if(file.isSubPath(filePath, siteSavePath))
    {
        file.createDirectoriesIfNeededForFilePath(filePath)
        if(type(fileInfo.data) == "string")
        {
            #print("saved raw data:", filePath)
            file.saveData(filePath, fileInfo.data) #write the string data (can be binary) to disk directly
        }
        else
        {
            file.saveBinary(filePath, fileInfo.data) #save the tui object as a binary export
            #print("saved tui object:", filePath)
        }
    }
}

showSiteManagement = function(hostedSiteBookmarkInfo)
{
    if(!hostedSiteManagement)
    {
        .hostedSiteManagement = require("app/katipoBrowser/scripts/hostedSiteManagement.tui")

        #hostedSiteManagement.siteContentBackground = siteContentBackground
        hostedSiteManagement.init(siteContentBackground, saveHostedBookmarks)
    }

    siteContentBackground.goalColor = vec4(0.0, 0.2, 0.01, 0.6) #green for editing host config

    defaultSiteContent.hidden = true
    browserManagementView.fadeOut()
    katipo.hideCurrentSite()
    hostedSiteManagement.show(hostedSiteBookmarkInfo, getHostSitePublicPath(hostedSiteBookmarkInfo.hostID))
    fadeSiteContent(true)
}

hideSiteManagement = function()
{
    if(hostedSiteManagement)
    {
        hostedSiteManagement.hide()
    }
}

installSite = function(hostSiteData, hostID, url)
{
    publicSiteSavePath = getHostSitePublicPath(hostID)
    file.mkdir(publicSiteSavePath)
    privateSiteSavePath = getHostSitePrivatePath(hostID)
    file.mkdir(privateSiteSavePath)

    checksums = false

    for(i, existing in hostedSiteBookmarks)
    {
        if(existing.hostID == hostID)
        {
            .checksums = existing.checksums
            table.remove(hostedSiteBookmarks, i)
            break
        }
    }

    if(!checksums)
    {
        checksums = {}
    }

    files = hostSiteData.siteFiles
    for(subFile in files)
    {
        writeFile(publicSiteSavePath, checksums, subFile)
    }

    hostedSiteBookmarkInfo = {
        url = url
        hostID = hostID
        siteInfo = hostSiteData.siteInfo
        checksums = checksums
        # the hostID is a string, and math.random can take either a number or a string as a seed for the second argument
        color = vec4(math.random(1.0, hostID + "1"), math.random(1.0, hostID + "2"), math.random(1.0, hostID + "3"), 1.0)
        #siteImage = hostSiteData.siteImage
    }
    table.insert(hostedSiteBookmarks, 0, hostedSiteBookmarkInfo)
    saveHostedBookmarks()
    
    setHostTabSelected(true)
    loadBookmarks()
    showSiteManagement(hostedSiteBookmarkInfo)
}

showInstallPanelForHostSite = function(hostSiteData, hostID, url)
{
    if(!hostSiteData.siteInfo)
    {
        error("missing hostSiteData.siteInfo")
    }
    if(!hostSiteData.siteInfo.title)
    {
        error("missing hostSiteData.siteInfo.title")
    }
    print("got hostSiteData siteInfo:", hostSiteData.siteInfo)
    siteContentBackground.goalColor = vec4(0.7,0.3,0.0,0.4) #orange warning, danger zone
    katipo.hideCurrentSite()

    #pageText += "#" + title + "\n" #tui bug adding anything to title on either side


    title = hostSiteData.siteInfo.title
    description = hostSiteData.siteInfo.description
    author = hostSiteData.siteInfo.author

    pageText = "#Do you wish to install and host " + title + "?\n\n"
    pageText += "#" + title + "\n"
    pageText += description + "\n"
    pageText += "by " + author + "\n\n"
    pageText += "This will download and install a copy of the site to this device, adding it to the list of hosts here in Katipo. Once added, you can start and stop the host, and connect to it from within this app or from other devices on your network.\n\n"
    pageText += "Warning: Hosting a site may pose a security risk. You should only do this if you trust the site creator and this host."

    if(!installHostContent)
    {
        installHostScene = require("app/katipoBrowser/scripts/installHostScene.tui")
        .installHostContent = siteContentBackground.addView(installHostScene.mainView)
    }


    installButton = installHostContent.getView("installButton")
    installButton.click = function()
    {
        installSite(hostSiteData, hostID, url)
        fadeSiteContent(false)
    }

    cancelButton = installHostContent.getView("cancelButton")
    cancelButton.click = function()
    {
        fadeSiteContent(false)
    }

    installHostPageBody = installHostContent.getView("pageBody")

    installHostContent.hidden = false
    installHostPageBody.setText(pageText)
}

loadClientSite = function(siteData, hostID, url)
{
    siteContentBackground.goalColor = vec4(0.0,0.0,0.2,0.4) #blue, we have the most recent version
    defaultSiteContent.hidden = true

    siteSavePath = getClientSitePath(hostID)
    file.mkdir(siteSavePath)

    checksums = false

    for(i, existing in bookmarks)
    {
        if(existing.hostID == hostID)
        {
            .checksums = existing.checksums
            table.remove(bookmarks, i)
            break
        }
    }

    if(!checksums)
    {
        checksums = {}
    }

    files = siteData.files
    for(subFile in files)
    {
        writeFile(siteSavePath, checksums, subFile)
    }

    publicData = siteData.publicData
    #print("got publicData:", publicData)
    katipo.loadSite(hostID, siteSavePath, publicData, untrustedSiteCodePermissionFunction, false)

    .currentSiteHostID = hostID

    bookmarkInfo = {
        url = url
        hostID = hostID
        siteInfo = siteData.siteInfo
        checksums = checksums
        # the hostID is a string, and math.random can take either a number or a string as a seed for the second argument
        color = vec4(math.random(1.0, hostID + "1"), math.random(1.0, hostID + "2"), math.random(1.0, hostID + "3"), 1.0)
        #siteImage = siteData.siteImage
    }
    table.insert(bookmarks, 0, bookmarkInfo)
    database.set("bookmarks", bookmarks)
    setHostTabSelected(false)
    loadBookmarks()
}

getCallback = function(result, hostID, url)
{
    print("getCallback url:", url, " currentURLFullLink:", currentURLFullLink)
    .getInProgress = false #warning this doesn't account for multiple requests returning in a row
    print("got result with status:", result.status, " message:", result.message, " hostID:", hostID, " url:", url)

    defaultSiteContent.hidden = true
    if(installHostContent)
    {
        installHostContent.hidden = true
    }

    if(result.status != "ok")
    {
        existing = findBookmark(url)
        if(existing)
        {
            siteContentBackground.goalColor = vec4(0.2,0.2,0.0,0.4) #yellow, we don't have a connection, loaded from cache
            katipo.loadSite(existing.hostID, getClientSitePath(existing.hostID), nil, untrustedSiteCodePermissionFunction, true)
        }
        else
        {
            siteContentBackground.goalColor = vec4(0.2,0.0,0.0,0.6) #red, we don't have a connection, no cache
            defaultSiteContent.hidden = false
            katipo.hideCurrentSite()
            pageBody.setText("#" + result.status + "\n" + result.message)
        }
    }
    else if(result.pageTitle)
    {
        siteContentBackground.goalColor = vec4(0.0,0.0,0.2,0.4)
        defaultSiteContent.hidden = false
        katipo.hideCurrentSite()

        if(result.pageBody)
        {
            pageBody.setText("#" + result.pageTitle + "\n" + result.pageBody)
        }
        else
        {
            pageBody.setText("#" + result.pageTitle)
        }
    }
    else if(result.hostSiteData)
    {
        showInstallPanelForHostSite(result.hostSiteData, hostID, url)
    }
    else if(result.siteData)
    {
        loadClientSite(result.siteData, hostID, url)
    }
    else
    {
        print("warning: unhandled result:", result)
        defaultSiteContent.hidden = false
        pageBody.setText("#Unhandled Result")
    }

    fadeSiteContent(true)
}

doGet = function(url, siteNameOrNil, checksumsOrNil)
{
    checksums = checksumsOrNil
    if(!checksums)
    {
        existingBookmark = findBookmark(url)
        if(existingBookmark)
        {
            checksums = existingBookmark.checksums
        }
    }

    .currentURLFullLink = stripDefaultPortFromUrl(url)
    .currentURLSiteName = siteNameOrNil
    .getInProgress = true
    fadeSiteContent(false)
    urlTextEntry.setText(currentURLSiteName)
    katipo.get(currentURLFullLink, checksums, getCallback)
    
    browserManagementView.fadeOut()
}

updateScrollViewSize = function()
{
    parentSize = bookmarksScrollView.parentSize
    bookMarkCount = table.count(bookmarks)
    if(hostTabSelected)
    {
        bookMarkCount = table.count(hostedSiteBookmarks)
    }
    totalHeight = scene.bookMarkHeight * bookMarkCount
    height = math.min(totalHeight, parentSize.y - scene.urlTextEntryHeight)
    width = math.min(scene.bookmarksListWidth, parentSize.x)
    bookmarksScrollView.size = vec2(width, height)
}

bookmarksScrollView.onParentSizeChanged = function(parentSize)
{
    bookmarksScrollView.parentSize = parentSize
    updateScrollViewSize()
    return bookmarksScrollView.size
}

stripDefaultPortFromUrl = function(fullUrl)
{
    foundIndex = string.find(fullUrl, ":3471/")
    if(foundIndex)
    {
        return string.subString(fullUrl, 0, foundIndex) + string.subString(fullUrl, foundIndex + 5)
    }
    return fullUrl
}



loadBookmarks = function()
{
    bookmarksScrollView.removeAllRows()
    bookmarksToUse = bookmarks
    if(hostTabSelected)
    {
        bookmarksToUse = hostedSiteBookmarks
    }
    for(i = table.count(bookmarksToUse) - 1, i>=0, i--)
    {
        bookmarkInfo = bookmarksToUse[i]
        if(bookmarkInfo.url) #todo remove this, works around early bug
        {
            bookmarkView = bookmarksScrollView.addView(bookmarkLayout)
            
            title = bookmarkInfo.siteInfo.title
            bookmarkTitleView = bookmarkView.getView("bookmarkTitle")
            bookmarkTitleView.text = title

            bookmarkSubtitleView = bookmarkView.getView("bookmarkSubtitle")
            displayUrl = stripDefaultPortFromUrl(bookmarkInfo.url)
            bookmarkSubtitleView.text = displayUrl

            bookmarkButton = bookmarkView.getView("bookmarkButton")
            backgroundColor = vec4(0.0,0.0,0.1,0.5)
            if(i % 2 == 0)
            {
                backgroundColor += vec4(0.1,0.15,0.12,0.0)
            }
            bookmarkButton.setColor(backgroundColor)

            if(bookmarkInfo.siteImage)
            {
                #todo
            }
            else
            {
                bookmarkMissingImage = bookmarkView.getView("bookmarkMissingImage")
                if(bookmarkInfo.color)
                {
                    bookmarkMissingImage.color = bookmarkInfo.color
                }
                bookmarkMissingImageCharacter = bookmarkView.getView("bookmarkMissingImageCharacter")
                bookmarkMissingImageCharacter.text = string.subString(title, 0, 1)
            }

            bookmarkButton = bookmarkView.getView("bookmarkButton")
            bookmarkButton.hueOffset = -0.1 - 0.1 * i

            if(hostTabSelected)
            {
                bookmarkButton.click = function()
                {
                    showSiteManagement(bookmarkInfo)
                }
            }
            else
            {
                bookmarkButton.click = function()
                {
                    siteContentBackground.goalColor = vec4(0.0, 0.015, 0.01, 0.6)
                    doGet(bookmarkInfo.url, bookmarkInfo.siteInfo.title, bookmarkInfo.checksums)
                }
            }
        }
    }
    updateScrollViewSize()
}


onStartedEditing = function()
{
    setHostTabSelected(false)
    loadBookmarks()

    browserManagementView.fadeIn()
    fadeSiteContent(false)

    urlTextEntry.setText(currentURLFullLink)
}
urlTextEntry.setOnStartedEditing(onStartedEditing)

urlTextFinishedEditing = function(textValue, changesMade)
{
    if(!changesMade and hostTabSelected)
    {
        return
    }

    browserManagementView.fadeOut()

    if(changesMade)
    {
        siteContentBackground.goalColor = vec4(0.0,0.015,0.01,0.6)
        doGet(textValue, nil, nil)
    }
    else if(!getInProgress)
    {
        fadeSiteContent(true)
    }
}
urlTextEntry.setOnFinishedEditing(urlTextFinishedEditing)

katipo.onLinkClick = function(linkString)
{
    doGet(linkString, nil, nil)
    urlTextEntry.setText(currentURLFullLink)
}


refreshButton.click = function()
{
    doGet(currentURLFullLink, nil, nil)
}

loadInitialLink = function()
{
    siteContentBackground.goalColor = vec4(0.0, 0.015, 0.01, 0.6)
    if(table.count(bookmarks) == 0)
    {
        doGet("katipobrowser.com/katipo")
    }
    else
    {
        bookmarkInfo = bookmarks[0]
        doGet(bookmarkInfo.url, bookmarkInfo.siteInfo.title, bookmarkInfo.checksums)
    }
}

loadInitialLink()



reloadKey = function(isDown, code, mod, isRepeat)
{
    if(isDown and !isRepeat and currentURLFullLink and (mod == keys.modifiers.ctrl or mod == keys.modifiers.cmd))
    {
        doGet(currentURLFullLink, nil, nil)
    }
}
#a full list of keycodes can be found in the katipo browser resources, within the file app/common/keys.tui
eventManager.addKeyEventListener(keys.keyCodes.r, reloadKey)

validZooms = {0.5,0.75,1.0,1.25,1.5,2.0,3.0,4.0}

addKey = function(isDown, code, mod, isRepeat)
{
    if(isDown and !isRepeat and (mod == keys.modifiers.ctrl or mod == keys.modifiers.cmd))
    {
        currentZoom = 1.0 / eventManager.uiScale + 0.01
        print("addKey key currentZoom:", currentZoom)
        
        for(zoom in validZooms)
        {
            if(zoom > currentZoom)
            {
                eventManager.uiScale = 1.0 / zoom
                break
            }
        }
    }
}
eventManager.addKeyEventListener(keys.keyCodes.equals, addKey)


minusKey = function(isDown, code, mod, isRepeat)
{
    if(isDown and !isRepeat and (mod == keys.modifiers.ctrl or mod == keys.modifiers.cmd))
    {
        currentZoom = 1.0 / eventManager.uiScale - 0.01
        print("minusKey key currentZoom:", currentZoom)
        
        prevZoom = validZooms[0]
        for(zoom in validZooms)
        {
            if(zoom > currentZoom)
            {
                eventManager.uiScale = 1.0 / prevZoom
                break
            }
        }
    }
}
eventManager.addKeyEventListener(keys.keyCodes.minus, minusKey)