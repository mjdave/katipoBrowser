
keys = require("app/common/keys.tui")

defaultSiteScene = require("app/katipoBrowser/scripts/defaultSiteScene.tui")

print("katipoBrowser is running")
currentSiteHostID = false #tui quirk, false instead of nil, as nil removes it
currentURLFullLink = ""
currentURLSiteName = false

bookmarksPath = file.getSavePath("bookmarks.tuib") #todo use database
bookmarks = file.loadBinary(bookmarksPath)
if(!bookmarks)
{
    bookmarks = {}
}

#print("loaded bookmarks:", bookmarks)

urlTextEntry = scene.getView("urlTextEntry")

windowSafeBackground = scene.getView("windowSafeBackground")
windowSafeBackground.onParentSizeChanged = function(parentSize)
{
    windowSafeArea = eventManager.getWindowSafeArea()
    windowSafeBackground.pos = vec3(windowSafeArea.x, -windowSafeArea.y, 0)
    return vec2(windowSafeArea.z, windowSafeArea.w)
}

siteContentBackground = scene.getView("siteContent")
siteContentBackground.update = function(dt)
{
    if(siteContentBackground.goalColor and siteContentBackground.goalColor != siteContentBackground.color)
    {
        siteContentBackground.color = math.mix(siteContentBackground.color, siteContentBackground.goalColor, dt * 4.0)
    }
}

defaultSiteContent = siteContentBackground.addView(defaultSiteScene.mainView)
defaultSiteContent.hidden = true

pageBody = defaultSiteContent.getView("pageBody")

bookmarkLayout = scene.bookmark
bookmarksScrollView = scene.getView("bookmarksScrollView")
bookmarksFullScreenBackground = scene.getView("bookmarksFullScreenBackground")

untrustedSiteCodePermissionFunction = function(functionName, args, hasPermissionCallback)
{
    print("Warning: host is attempting to use protected tui function:\"", functionName, "\" with args:", args, "\nTODO: Katipo needs to check client settings or ask if this is OK, but for now it is not OK")
    hasPermissionCallback(false)
}

getSitePath = function(hostID)
{
    return file.getSavePath("browserSites/" + hostID + "/")
}

findBookmark = function(url)
{
    for(i, existing in bookmarks)
    {
        if(existing.url == url)
        {
            return existing
        }
    }
    return nil
}

getCallback = function(result, hostID, url)
{
    print("got result with status:", result.status, " message:", result.message, " hostID:", hostID, " url:", url)
    if(result.status != "ok")
    {
        existing = findBookmark(url)
        if(existing)
        {
            siteContentBackground.goalColor = vec4(0.2,0.2,0.0,0.4) #yellow, we don't have a connection, loaded from cache
            katipo.loadSite(existing.hostID, getSitePath(existing.hostID), nil, untrustedSiteCodePermissionFunction, true)
        }
        else
        {
            siteContentBackground.goalColor = vec4(0.2,0.0,0.0,0.6) #red, we don't have a connection, no cache
            defaultSiteContent.hidden = false
            pageBody.setText("#" + result.status + "\n" + result.message)
        }
    }
    else if(result.pageTitle)
    {
        siteContentBackground.goalColor = vec4(0.0,0.0,0.2,0.4)
        defaultSiteContent.hidden = false

        if(result.pageBody)
        {
            pageBody.setText("#" + result.pageTitle + "\n" + result.pageBody)
        }
        else
        {
            pageBody.setText("#" + result.pageTitle)
        }
    }
    else if(result.siteData)
    {
        siteContentBackground.goalColor = vec4(0.0,0.0,0.2,0.4) #blue, we have the most recent version
        defaultSiteContent.hidden = true

        siteSavePath = getSitePath(hostID)
        file.mkdir(siteSavePath)

        checksums = false

        for(i, existing in bookmarks)
        {
            if(existing.hostID == hostID)
            {
                .checksums = existing.checksums
                table.remove(bookmarks, i)
                break
            }
        }

        if(!checksums)
        {
            checksums = {}
        }

        #print("found existing checksums:", checksums)

        files = result.siteData.files

        writeFile = function(fileInfo)
        {
            #print("fileInfo:", fileInfo)
            filePath = siteSavePath + fileInfo.fileName
            checksums[fileInfo.fileName] = fileInfo.checksum
            if(file.isSubPath(filePath, siteSavePath))
            {
                file.createDirectoriesIfNeededForFilePath(filePath)
                if(type(fileInfo.data) == "string")
                {
                    #print("saved raw data:", filePath)
                    file.saveData(filePath, fileInfo.data) #write the string data (can be binary) to disk directly
                }
                else
                {
                    file.saveBinary(filePath, fileInfo.data) #save the tui object as a binary export
                    #print("saved tui object:", filePath)
                }
            }
        }

        for(subFile in files)
        {
            writeFile(subFile)
        }


        publicData = result.siteData.publicData

        #print("got publicData:", publicData)

        #print("loading freshly updated site code")
        katipo.loadSite(hostID, siteSavePath, publicData, untrustedSiteCodePermissionFunction, false)

        .currentSiteHostID = hostID

        #update bookmarks

        #print("updated checksums:", checksums)

        #print("storing checksum:", result.siteData.checksum)

        bookmarkInfo = {
            url = url
            hostID = hostID
            siteInfo = result.siteData.siteInfo
            checksums = checksums
            # the hostID is a string, and math.random can take either a number or a string as a seed for the second argument
            color = vec4(math.random(1.0, hostID + "1"), math.random(1.0, hostID + "2"), math.random(1.0, hostID + "3"), 1.0)
            #siteImage = result.siteData.siteImage
        }
        table.insert(bookmarks, 0, bookmarkInfo)

        file.saveBinary(bookmarksPath, bookmarks) #todo use database
    }
    else
    {
        print("warning: unhandled result:", result)
        defaultSiteContent.hidden = false
        pageBody.setText("#Unhandled Result")
    }
}


bookmarksScrollView.onParentSizeChanged = function(parentSize)
{
    totalHeight = scene.bookMarkHeight * table.count(bookmarks)
    height = math.min(totalHeight, parentSize.y - scene.urlTextEntryHeight)
    width = math.min(scene.bookmarksListWidth, parentSize.x)
    return vec2(width, height)
}

getDisplayUrl = function(fullUrl)
{
    foundIndex = string.find(fullUrl, ":3471/")
    if(foundIndex)
    {
        return string.subString(fullUrl, 0, foundIndex) + string.subString(fullUrl, foundIndex + 5)
    }
    return fullUrl
}

loadBookmarks = function()
{
    bookmarksScrollView.removeAllRows()
    for(i = table.count(bookmarks) - 1, i>=0, i--)
    {
        bookmarkInfo = bookmarks[i]
        bookmarkView = bookmarksScrollView.addView(bookmarkLayout)
        
        title = bookmarkInfo.siteInfo.title
        bookmarkTitleView = bookmarkView.getView("bookmarkTitle")
        bookmarkTitleView.text = title

        bookmarkSubtitleView = bookmarkView.getView("bookmarkSubtitle")
        displayUrl = getDisplayUrl(bookmarkInfo.url)
        bookmarkSubtitleView.text = displayUrl

        if(i % 2 == 0)
        {
            bookmarkView.color += vec4(0.1,0.15,0.12,0.0)
        }

        if(bookmarkInfo.siteImage)
        {
            #todo
        }
        else
        {
            bookmarkMissingImage = bookmarkView.getView("bookmarkMissingImage")
            if(bookmarkInfo.color)
            {
                bookmarkMissingImage.color = bookmarkInfo.color
            }
            bookmarkMissingImageCharacter = bookmarkView.getView("bookmarkMissingImageCharacter")
            bookmarkMissingImageCharacter.text = string.subString(title, 0, 1)
        }

        bookmarkClick = function()
        {
            siteContentBackground.goalColor = vec4(0.0, 0.015, 0.01, 0.6)
            .currentURLFullLink = getDisplayUrl(bookmarkInfo.url)
            .currentURLSiteName = bookmarkInfo.siteInfo.title
            urlTextEntry.setText(currentURLSiteName)
            katipo.get(bookmarkInfo.url, bookmarkInfo.checksums, getCallback)

            bookmarksScrollView.fadeOut()
            bookmarksFullScreenBackground.fadeOut()
        }

        bookmarkButton = bookmarkView.getView("bookmarkButton")
        bookmarkButton.click = bookmarkClick
        bookmarkButton.hueOffset = -0.1 - 0.1 * i
    }
}

urlTextEntry.onChange = function(textValue, confirmChanges)
{
    if(confirmChanges and string.length(textValue) > 0)
    {
        siteContentBackground.goalColor = vec4(0.0,0.015,0.01,0.6)
        existingBookmark = findBookmark(textValue)
        checksums = nil
        if(existingBookmark)
        {
            checksums = existingBookmark.checksums
        }

        katipo.get(textValue, checksums, getCallback)
        .currentURLFullLink = textValue
        .currentURLSiteName = false
    }
    else
    {
        urlTextEntry.revertToEditStartText()
    }
}

urlTextEntry.onStartedEditing = function()
{
    loadBookmarks()
    urlTextEntry.setText(currentURLFullLink)
    bookmarksScrollView.fadeIn()
    bookmarksFullScreenBackground.fadeIn()
}

urlTextEntry.onFinishedEditing = function()
{
    bookmarksScrollView.fadeOut()
    bookmarksFullScreenBackground.fadeOut()

    if(currentURLSiteName)
    {
        urlTextEntry.setText(currentURLSiteName)
    }
}

katipo.onLinkClick = function(linkString)
{
    .currentURLFullLink = linkString
    .currentURLSiteName = false
    urlTextEntry.setText(currentURLFullLink)
    existingBookmark = findBookmark(linkString)
    checksums = nil
    if(existingBookmark)
    {
        checksums = existingBookmark.checksums
    }
    katipo.get(linkString, checksums, getCallback)
}


reloadKey = function(isDown, code, mod, isRepeat)
{
    if(isDown and !isRepeat and currentURLFullLink and (mod == keys.modifiers.ctrl or mod == keys.modifiers.cmd))
    {
        existingBookmark = findBookmark(currentURLFullLink)
        checksums = nil
        if(existingBookmark)
        {
            checksums = existingBookmark.checksums
        }
        katipo.get(currentURLFullLink, checksums, getCallback)
    }
}

#a full list of keycodes can be found in the katipo browser resources, within the file app/common/keys.tui
eventManager.addKeyEventListener(keys.keyCodes.r, reloadKey)

loadInitialLink = function()
{
    siteContentBackground.goalColor = vec4(0.0, 0.015, 0.01, 0.6)
    if(table.count(bookmarks) == 0)
    {
        url = "katipobrowser.com/katipo"
        .currentURLFullLink = url
        .currentURLSiteName = false
        urlTextEntry.setText(currentURLFullLink)
        katipo.get(url, getCallback)
    }
    else
    {
        bookmarkInfo = bookmarks[0]
        .currentURLFullLink = bookmarkInfo.url
        .currentURLSiteName = bookmarkInfo.siteInfo.title
        urlTextEntry.setText(currentURLSiteName)
        katipo.get(bookmarkInfo.url, bookmarkInfo.checksums, getCallback)
    }
}

loadInitialLink()
