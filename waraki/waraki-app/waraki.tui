keys = require("app/common/keys.tui")
urlTextEntry = scene.getView("urlTextEntry")
urlTextEntry.hidden = true

welcomePage = false
createLibraryPage = false
connectPage = false

bundledHostIP = "127.0.0.1"
bundledHostID = bundledHostIP + "/waraki"

allowHosting = (platform() != "ios")

windowSafeBackground = scene.getView("windowSafeBackground")
windowSafeBackground.onParentSizeChanged = function(parentSize)
{
    windowSafeArea = eventManager.getWindowSafeArea()
    windowSafeBackground.pos = vec3(windowSafeArea.x, -windowSafeArea.y, 0)
    return vec2(windowSafeArea.z, windowSafeArea.w)
}

siteContentBackground = scene.getView("siteContent")
siteContentBackground.update = function(dt)
{
    if(siteContentBackground.goalColor and siteContentBackground.goalColor != siteContentBackground.color)
    {
        siteContentBackground.color = math.mix(siteContentBackground.color, siteContentBackground.goalColor, dt * 4.0)
    }
}



getClientSitePath = function(hostID)
{
    return file.getSavePath("clientSites/" + hostID + "/")
}

untrustedSiteCodePermissionFunction = function(functionName, args, hasPermissionCallback)
{
    print("Warning: host is attempting to use protected tui function:\"", functionName, "\" with args:", args, "\nTODO: Katipo needs to check client settings or ask if this is OK, but for now it is not OK")
    hasPermissionCallback(false)
}


writeFile = function(siteSavePath, checksums, fileInfo)
{
    #print("fileInfo:", fileInfo)
    filePath = siteSavePath + fileInfo.fileName
    checksums[fileInfo.fileName] = fileInfo.checksum
    if(file.isSubPath(filePath, siteSavePath))
    {
        file.createDirectoriesIfNeededForFilePath(filePath)
        if(type(fileInfo.data) == "string")
        {
            #print("saved raw data:", filePath)
            file.saveData(filePath, fileInfo.data) #write the string data (can be binary) to disk directly
        }
        else
        {
            file.saveBinary(filePath, fileInfo.data) #save the tui object as a binary export
            #print("saved tui object:", filePath)
        }
    }
}

loadClientSite = function(siteData, hostID, url) #only called if we have a connection, not from the cache
{
    siteContentBackground.goalColor = vec4(0.0,0.0,0.2,0.4) #blue, we have the most recent version

    siteSavePath = getClientSitePath(hostID)
    file.mkdir(siteSavePath)

    checksumKey = "checksums_" + hostID
    checksums = database.get(checksumKey)
    if(!checksums)
    {
        checksums = {}
    }

    files = siteData.files
    for(subFile in files)
    {
        writeFile(siteSavePath, checksums, subFile)
    }

    publicData = siteData.publicData
    #print("got publicData:", publicData)
    katipo.loadSite(hostID, siteSavePath, publicData, untrustedSiteCodePermissionFunction, false)

    database.set(checksumKey, checksums)

    hostInfo = { #todo should save a title too from a siteInfo somehow for display
        hostID = hostID
        url = url
    }
    database.set("lastHost", hostInfo)

    recentHosts = database.get("recentHosts")
    if(recentHosts)
    {
        for(i,otherHostInfo in recentHosts)
        {
            if(otherHostInfo.hostID == hostID)
            {
                table.remove(recentHosts, i)
                break
            }
        }
        table.insert(recentHosts, 0, hostInfo)
    }
    else
    {
        recentHosts = {
            hostInfo
        }
    }
    database.set("recentHosts", recentHosts)
}

getCallback = function(result, hostID, url)
{
    print("getCallback url:", url, " currentURLFullLink:", currentURLFullLink)
    print("got result with status:", result.status, " message:", result.message, " hostID:", hostID, " url:", url)

    if(result.status != "ok")
    {
        cacheLoaded = katipo.loadSite(hostID, getClientSitePath(hostID), nil, untrustedSiteCodePermissionFunction, true) #load cache
        if(!cacheLoaded)
        {
            runSetup()
        }
    }
    else if(result.siteData)
    {
        loadClientSite(result.siteData, hostID, url)
    }
    else
    {
        print("warning: unhandled result:", result)
    }
}

createMusicDirectoryName = false

updateCreateLibraryMarkup = function()
{
    markup = "# Select music files directory\n\n"

    markup += "Please select where your music files are stored on your device. Waraki will search this directory and all sub-directories for any mp3, m4a, ogg, or flac files.\n\n"

    if(createMusicDirectoryName)
    {
        markup += createMusicDirectoryName
    }
    else
    {
        markup += "No music directory"
    }

    markup += " [Select Folder->](id = 'selectLibraryFileOpenButton')\n\n"

    markup += "[<- Back](id='cancelButton')"

    if(createMusicDirectoryName)
    {
        markup += "            [Start ->](id='okButton')"
    }

    .createLibraryPage = siteContent.getView("createLibraryPage")
    createLibraryPage.setText(markup)
}

createLibraryClicked = function()
{
    if(welcomePage)
    {
        welcomePage.fadeOut()
    }

    if(katipo.siteView)
    {
        katipo.siteView.hidden = true
    }

    .createMusicDirectoryName = database.get("bundledHostMusicLibraryPath")
    updateCreateLibraryMarkup()

    createLibraryPage.fadeIn()
}

stopBundledHost = function()
{
    database.set("bundledHostRunning", false)
    katipo.setBundledHostRunning(bundledHostID, false)
}

scanFoundResults = {}
foundResult = false
connectPageMarkup = false
customIP = "katipobrowser.com/waraki"

addRecentConnectionsMarkup = function()
{
    result = ""
    recentHosts = database.get("recentHosts")
    if(recentHosts and table.count(recentHosts) > 0)
    {
        result += "#Stored Libraries\n\n"
        for(i,siteInfo in recentHosts)
        {
            if(siteInfo.hostID != bundledHostID)
            {
                buttonID = "recentButton" + i
                result += "    " + siteInfo.url + "    [Connect/Load ->](id='" + buttonID + "')\n"

                clickFunction = function()
                {
                    hostID = siteInfo.url
                    checksumKey = "checksums_" + hostID
                    katipo.get(hostID, database.get(checksumKey), getCallback)
                    connectPage.fadeOut()
                }

                connectPage.styles[buttonID] = {
                    link = clickFunction
                }

                if(i >= 9)
                {
                    break
                }
            }
        }
        result += "\n"
    }
    return result
}

scanCallback = function(status, result)
{
    if(status == "error")
    {
        thisMarkup = "#Scan failed\n" + "Something went wrong, the app may not have permission to access your local network.\n" 
        thisMarkup += addRecentConnectionsMarkup()
        thisMarkup += connectPageMarkup
        connectPage.setText(thisMarkup)
    }
    else if(status == "connected") #NOTE we might get this multiple times, before complete is called finally
    {
        print("result:", result)
        if(result.sites and table.count(result.sites) > 0) #a tracker with no matching hosts still gives us connected callback, but no sites
        {
            .foundResult = true
            table.insert(scanFoundResults, result)

            thisMarkup = "#Waraki music library found\n\n"
            buttonCount = 0
            for(i, trackerResult in scanFoundResults)
            {
                ip = trackerResult.ip
                trackerKey = trackerResult.trackerKey
                sites = trackerResult.sites

                for(j, siteInfo in sites)
                {
                    buttonID = "connectButton" + buttonCount
                    buttonCount++
                    thisMarkup += siteInfo.title + " - " + ip + "    [Connect ->](id='" + buttonID + "')\n\n"

                    clickFunction = function()
                    {
                        katipo.connectToScanResult(ip) #this transfers the tracker connection, saves time having to reconnect with the call to katipo.get
                        hostID = trackerKey + "/" + siteInfo.nameKey
                        checksumKey = "checksums_" + hostID
                        katipo.get(hostID, database.get(checksumKey), getCallback)
                        connectPage.fadeOut()
                    }

                    connectPage.styles[buttonID] = {
                        link = clickFunction
                    }
                }
            }

            thisMarkup += addRecentConnectionsMarkup()
            thisMarkup += connectPageMarkup

            connectPage.setText(thisMarkup)
            return true #keep the connection live
        }
        else
        {
            return false #dispose of the connection
        }
    }
    else if(status == "complete")
    {
        if(!foundResult)
        {
            thisMarkup = "#Scan complete\n\n" 
            thisMarkup += "No Waraki music libraries found on your network.\n\n"
            thisMarkup += addRecentConnectionsMarkup()
            thisMarkup += connectPageMarkup
            connectPage.setText(thisMarkup)
        }
    }
    return false
}


connectClicked = function()
{
    if(welcomePage)
    {
        welcomePage.fadeOut()
    }

    if(katipo.siteView)
    {
        katipo.siteView.hidden = true
    }

    if(!connectPage)
    {
        filePath = file.getResourcePath("waraki-app/connect.tml")
        .connectPageMarkup = file.loadData(filePath)
        .connectPage = siteContent.getView("connectPage")

        if(!allowHosting)
        {
            connectPage.styles.cancelButton.hidden = true
        }
    }

    .foundResult = false
    .scanFoundResults = {}
    stopBundledHost()
    katipo.startScan("waraki", scanCallback)

    thisMarkup = "#Searching...\n\n" 
    thisMarkup += "Waraki is scanning your local network for music libraries.\n\n"
    thisMarkup += connectPageMarkup
    connectPage.setText(thisMarkup)
    connectPage.fadeIn()
}

createLibraryCancelClicked = function()
{
    createLibraryPage.fadeOut()
    welcomePage.fadeIn()
}

createLibraryOKClicked = function()
{
    createLibraryPage.fadeOut()
    userConfiguration = {
        musicLibraryPath = createMusicDirectoryName
    }

    running = katipo.setBundledHostRunning(bundledHostID, true, userConfiguration)
    if(running)
    {
        print("started bundled host")
        database.set("bundledHostRunning", true)
        database.set("bundledHostMusicLibraryPath", createMusicDirectoryName)

        checksumKey = "checksums_" + bundledHostID
        katipo.get(bundledHostID, database.get(checksumKey), getCallback)

    }
    else
    {
        print("failed to start bundled host")
        runSetup()
    }
}



createLibraryOpenFileDialogClicked = function()
{
    folderSelectedFunction = function(selectionResult)
    {
        if(selectionResult and table.count(selectionResult) > 0)
        {
            .createMusicDirectoryName = selectionResult[0]
        }
        updateCreateLibraryMarkup()
    }

    katipo.openFolderDialog("/", folderSelectedFunction)
}

connectCancelClicked = function()
{
    connectPage.fadeOut()
    welcomePage.fadeIn()
}



showCustomEntryLinkClicked = function()
{
