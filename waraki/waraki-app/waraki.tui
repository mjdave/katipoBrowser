init = function()
{
    siteContentBackground.goalColor = vec4(0.0, 0.2, 0.8, 0.3)

    welcomeFilePath = file.getResourcePath("waraki-app/welcome.tml")
    markup = file.loadData(welcomeFilePath)

    .welcomePage = siteContent.getView("welcomePage")

    welcomePage.setText(markup)
    welcomePage.fadeIn()
}

init()

