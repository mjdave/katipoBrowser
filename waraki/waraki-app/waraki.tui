    type = "view"
    subviews = {
        {
            id = "welcomePage"
            type = "markup"
            hidden = true
            styles = {
                connectButton = {
                    link = connectClicked
                }
                createLibraryButton = {
                    link = createLibraryClicked
                }
            }
        }

        {
            id = "createLibraryPage"
            type = "markup"
            hidden = true
            styles = {
                cancelButton = {
                    link = createLibraryCancelClicked
                }
                okButton = {
                    link = createLibraryOKClicked
                }
                selectLibraryFileOpenButton = {
                    link = createLibraryOpenFileDialogClicked
                }
            }
        }

        {
            id = "connectPage"
            type = "markup"
            hidden = true
            styles = {
                cancelButton = {
                    link = connectCancelClicked
                }
                customConnectButton = {
                    link = customConnectButtonClicked
                }
                showCustomEntryLink = {
                    link = showCustomEntryLinkClicked
                }
                customIPTextEntry = {
                    textEntry = customIPTextEntryChanged # setting this function sets this as editable
                    backgroundColor = vec4(0.0,0.3,0.6,0.8)
                }
                customEntry = {
                    hidden = true
                }
            }
        }
    }
}

siteContent = siteContentBackground.addView(mainViewLayout)

runSetup = function()
{
    katipo.hideCurrentSite()

    if(allowHosting)
    {
        .welcomePage = siteContent.getView("welcomePage")

        welcomeFilePath = file.getResourcePath("waraki-app/welcome.tml")
        markup = file.loadData(welcomeFilePath)
        welcomePage.setText(markup)
        welcomePage.fadeIn()
    }
    else
    {
        connectClicked()
    }
}

katipo.registerAppFunction("runSetup", runSetup) #allows this to be called from the clientSite via katipo.callAppFunction


init = function()
{
    siteContentBackground.goalColor = vec4(0.0, 0.2, 0.8, 0.3)


    bundledHostWasRunning = database.get("bundledHostRunning")
    if(bundledHostWasRunning)
    {
        bundledHostWasRunning = katipo.setBundledHostRunning(bundledHostID, true)
        if(bundledHostWasRunning)
        {
            checksumKey = "checksums_" + bundledHostID
            katipo.get(bundledHostID, database.get(checksumKey), getCallback)
        }
        else
        {
            database.set("bundledHostRunning", false)
        }
    }
    
    
    if(!bundledHostWasRunning)
    {
        lastHost = database.get("lastHost")
        if(lastHost)
        {
            hostID = lastHost.hostID
            checksumKey = "checksums_" + lastHost.hostID
            localGetCallback = function(result, hostID_bad, url) #todo haccck for host id
            {
                getCallback(result, hostID, url)
            }

            katipo.get(lastHost.url, database.get(checksumKey), localGetCallback)
        }
        else
        {
            runSetup()
        }
    }
}

init()

reloadKey = function(isDown, code, mod, isRepeat)
{
    if(isDown and !isRepeat and (mod == keys.modifiers.ctrl or mod == keys.modifiers.cmd))
    {
        katipo.hideCurrentSite()
        init()
    }
}
eventManager.addKeyEventListener(keys.keyCodes.r, reloadKey)