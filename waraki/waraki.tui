
urlTextEntry = scene.getView("urlTextEntry")
urlTextEntry.hidden = true

windowSafeBackground = scene.getView("windowSafeBackground")
windowSafeBackground.onParentSizeChanged = function(parentSize)
{
    windowSafeArea = eventManager.getWindowSafeArea()
    windowSafeBackground.pos = vec3(windowSafeArea.x, -windowSafeArea.y, 0)
    return vec2(windowSafeArea.z, windowSafeArea.w)
}

siteContentBackground = scene.getView("siteContent")
siteContentBackground.update = function(dt)
{
    if(siteContentBackground.goalColor and siteContentBackground.goalColor != siteContentBackground.color)
    {
        siteContentBackground.color = math.mix(siteContentBackground.color, siteContentBackground.goalColor, dt * 4.0)
    }
}

getClientSitePath = function(hostID)
{
    return file.getSavePath("clientSites/" + hostID + "/")
}

untrustedSiteCodePermissionFunction = function(functionName, args, hasPermissionCallback)
{
    print("Warning: host is attempting to use protected tui function:\"", functionName, "\" with args:", args, "\nTODO: Katipo needs to check client settings or ask if this is OK, but for now it is not OK")
    hasPermissionCallback(false)
}

loadClientSite = function(siteData, hostID, url)
{
    siteContentBackground.goalColor = vec4(0.0,0.0,0.2,0.4) #blue, we have the most recent version

    siteSavePath = getClientSitePath(hostID)
    file.mkdir(siteSavePath)

    checksums = database.get("checksums")
    if(!checksums)
    {
        checksums = {}
    }

    files = siteData.files
    for(subFile in files)
    {
        writeFile(siteSavePath, checksums, subFile)
    }

    publicData = siteData.publicData
    #print("got publicData:", publicData)
    katipo.loadSite(hostID, siteSavePath, publicData, untrustedSiteCodePermissionFunction, false)

    database.set("checksums", checksums)
}

getCallback = function(result, hostID, url)
{
    print("getCallback url:", url, " currentURLFullLink:", currentURLFullLink)
    print("got result with status:", result.status, " message:", result.message, " hostID:", hostID, " url:", url)

    if(result.status != "ok")
    {
        katipo.loadSite(hostID, getClientSitePath(hostID), nil, untrustedSiteCodePermissionFunction, true) #load cache
    }
    else if(result.siteData)
    {
        loadClientSite(result.siteData, hostID, url)
    }
    else
    {
        print("warning: unhandled result:", result)
    }
}

loadInitialLink = function()
{
    siteContentBackground.goalColor = vec4(0.0, 0.015, 0.01, 0.6)
    katipo.get("waraki", database.get("checksums"), getCallback)
}

katipo.setBundledHostRunning("waraki", true)

loadInitialLink()